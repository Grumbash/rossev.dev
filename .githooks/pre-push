#!/bin/sh
# Performance gate. Each pushed branch is built and measured as pushed (not the working tree)
# in a throwaway worktree: byte budgets and Lighthouse from perf-budgets.json. On a breach,
# ask the perf-watchdog agent why, then block the push.
# Bypass: git push --no-verify. Bytes only: PERF_SKIP_LIGHTHOUSE=1. No agent: PERF_NO_AGENT=1.

remote=${1:-origin}
root=$(git rev-parse --show-toplevel) || exit 1

targets=$(sh "$root/scripts/push-range.sh" "$remote")
if [ -z "$targets" ]; then
  echo "perf: no site changes in this push, skipping the perf gate"
  exit 0
fi

tmp=""
cleanup() {
  [ -n "$tmp" ] || return 0
  git -C "$root" worktree remove --force "$tmp/wt" >/dev/null 2>&1
  rm -rf "$tmp"
  tmp=""
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

# Run "$@" for at most $1 seconds; uses timeout/gtimeout when present (macOS has neither).
with_timeout() {
  secs=$1; shift
  if command -v timeout >/dev/null 2>&1; then timeout "$secs" "$@"; return; fi
  if command -v gtimeout >/dev/null 2>&1; then gtimeout "$secs" "$@"; return; fi
  "$@" &
  pid=$!
  # Detached from our stdout/stderr: an orphaned sleep must not keep the pipe open after "$@" ends.
  (sleep "$secs" && kill "$pid") >/dev/null 2>&1 &
  killer=$!
  wait "$pid"
  rc=$?
  kill "$killer" 2>/dev/null
  return $rc
}

failed_range=""
while read -r sha range; do
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/perf-push.XXXXXX")
  (cd "$root" && git worktree add --detach -q "$tmp/wt" "$sha") || exit 1
  # A real install, not a symlink to ../node_modules: Astro cannot compile .astro files whose
  # realpath is outside the project. From bun's cache this takes well under a second.
  (cd "$tmp/wt" && { bun install --frozen-lockfile --ignore-scripts --silent ||
    bun install --ignore-scripts --silent; }) || { echo "perf: bun install failed in the pushed commit"; exit 1; }
  echo "perf: measuring $(git rev-parse --short "$sha") ($range)"
  (cd "$root" && bun run perf "$tmp/wt") || failed_range=$range
  cleanup
  [ -n "$failed_range" ] && break
done <<EOF_TARGETS
$targets
EOF_TARGETS

[ -z "$failed_range" ] && exit 0

if [ -f "$root/.perf/last-report.md" ] && [ -z "$PERF_NO_AGENT" ] && command -v claude >/dev/null 2>&1; then
  echo
  echo "perf: asking the perf-watchdog agent what got slower (up to 180s)..."
  prompt="The perf gate failed on git push. Read .perf/last-report.md and perf-budgets.json, then inspect the pushed range $failed_range with git log / git diff / git show. Say which change most likely caused each breach and the smallest fix."
  # Prompt first and tool lists in --flag=value form: the tool flags are variadic and would
  # otherwise swallow the prompt. stdin closed: the hook's stdin holds the pushed refs.
  (cd "$root" && with_timeout 180 claude -p "$prompt" --agent perf-watchdog --permission-mode default --max-turns 15 \
    --allowedTools="Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*)" \
    --disallowedTools="Edit,Write,NotebookEdit" </dev/null) \
    || echo "perf: the agent did not finish; see .perf/last-report.md"
fi

echo
echo "perf: push blocked. Full report: .perf/last-report.md"
echo "perf: to push anyway: git push --no-verify (or PERF_SKIP_LIGHTHOUSE=1 git push for bytes only)"
exit 1
