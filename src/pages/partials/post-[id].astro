---
import { BLOG_POSTS, readTimeLabel } from '../../data/profile';
import PostBrief from '../../components/PostBrief.astro';

export const partial = true;

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const readTime = readTimeLabel(post);
---

<!-- A fragment for the inline reader; the indexable copy is /writing/<slug>/.
     Kept out of the index by the X-Robots-Tag header on /partials/* (vercel.json). -->
<div class="brutal-box post-reader-drawer" style="margin-bottom: 24px; background: var(--surface); border-color: var(--border);">
  <div class="blueprint-header">
    <span>
      <span class="lang-en">// ENGINEERING NOTE BRIEF // {post.categoryLabel.en} · {readTime.en}</span>
      <span class="lang-ru">// КОНСПЕКТ ИНЖЕНЕРНОЙ ЗАМЕТКИ // {post.categoryLabel.ru} · {readTime.ru}</span>
    </span>
    <button
      type="button"
      class="brutal-btn brutal-btn-sm"
      onclick="document.getElementById('post-reader-slot').innerHTML = ''; window.setUrlParam && window.setUrlParam('post', null)"
    >
      <span class="lang-en">CLOSE ×</span><span class="lang-ru">ЗАКРЫТЬ ×</span>
    </button>
  </div>

  <div style="padding: 22px 24px;">
    <h3 class="post-reader-heading" tabindex="-1" style="font-family: var(--font-display); font-size: 1.45rem; font-weight: 800; margin-bottom: 10px;">
      <span class="lang-en">{post.title.en}</span>
      <span class="lang-ru">{post.title.ru}</span>
    </h3>

    <PostBrief post={post} inline />
  </div>
</div>
