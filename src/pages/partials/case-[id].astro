---
import { CASE_STUDIES, EXPERIENCE } from '../../data/profile';
import CaseBlueprint from '../../components/CaseBlueprint.astro';

export const partial = true;

export function getStaticPaths() {
  return CASE_STUDIES.filter((c) => EXPERIENCE.some((e) => e.caseId === c.id)).map((study) => ({
    params: { id: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
---

<!-- A fragment for home's <details class="job-case">, loaded on first open by case-loader.ts; the
     indexable copy is /cases/<id>/. The job card above already lists outcomes as bullets. -->
<CaseBlueprint study={study} showOutcomes={false} />
