---
import TerminalOutput from '../../components/TerminalOutput.astro';

export const partial = true;

export function getStaticPaths() {
  return [
    { params: { cmd: 'status' } },
    { params: { cmd: 'ai-harness' } },
    { params: { cmd: 'leadership' } },
    { params: { cmd: 'med-to-ai' } },
  ];
}

const { cmd } = Astro.params;
---

<TerminalOutput cmd={cmd || 'status'} />
