---
import { CASE_STUDIES, EXPERIENCE } from '../../../data/profile';
import CaseBlueprint from '../../../components/CaseBlueprint.astro';
import { localeOf, localeParams } from '../../../i18n';

export const partial = true;

export function getStaticPaths() {
  return localeParams().flatMap((params) =>
    CASE_STUDIES.filter((c) => EXPERIENCE.some((e) => e.caseId === c.id)).map((study) => ({
      params: { ...params, id: study.id },
      props: { study },
    })),
  );
}

const { study } = Astro.props;
const lang = localeOf(Astro.params.locale);
---

<!-- A fragment for home's <details class="job-case">, loaded on first open by case-loader.ts; the
     indexable copy is /cases/<id>/. The job card above already lists outcomes as bullets. -->
<CaseBlueprint study={study} lang={lang} showOutcomes={false} />
