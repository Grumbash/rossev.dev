---
import { BLOG_POSTS, readTimeLabel } from '../../../data/profile';
import PostBrief from '../../../components/PostBrief.astro';
import { localeOf, localeParams, t } from '../../../i18n';

export const partial = true;

export function getStaticPaths() {
  return localeParams().flatMap((params) =>
    BLOG_POSTS.map((post) => ({
      params: { ...params, id: post.id },
      props: { post },
    })),
  );
}

const { post } = Astro.props;
const lang = localeOf(Astro.params.locale);
const d = t(lang).reader;
const readTime = readTimeLabel(post);
---

<!-- A fragment for the inline reader; the indexable copy is /writing/<slug>/ (or /ru/writing/<slug>/).
     Kept out of the index by the X-Robots-Tag header on /partials/* and /ru/partials/* (vercel.json). -->
<div class="brutal-box post-reader-drawer" style="margin-bottom: 24px; background: var(--surface); border-color: var(--border);">
  <div class="blueprint-header">
    <span>{d.header} {post.categoryLabel[lang]} · {readTime[lang]}</span>
    <button
      type="button"
      class="brutal-btn brutal-btn-sm"
      data-action="closeBrief"
    >
      {d.close}
    </button>
  </div>

  <div style="padding: 22px 24px;">
    <h3 class="post-reader-heading" tabindex="-1" style="font-family: var(--font-display); font-size: 1.45rem; font-weight: 800; margin-bottom: 10px;">
      {post.title[lang]}
    </h3>

    <PostBrief post={post} lang={lang} inline />
  </div>
</div>
