---
// Every post page in one crawlable list. Home's grid is the latest posts with filters and the inline reader.
import { postPath } from '../../../data/profile';
import { BLOG_POSTS } from '../../../data/posts';
import Base from '../../../layouts/Base.astro';
import { localeOf, localePath, localeStaticPaths, t } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;

const lang = localeOf(Astro.params.locale);
const d = t(lang);
const posts = [...BLOG_POSTS].sort((a, b) => b.published.localeCompare(a.published));
---

<Base title={d.meta.writingTitle} description={d.meta.writingDescription}>
  <section class="section-block">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-kicker">{d.writing.kicker}</span>
          <h1 class="section-title">{d.writing.title}</h1>
        </div>
      </div>

      <div class="posts-grid">
        {posts.map((post) => (
          <article class="brutal-box post-card">
            <div>
              <div class="post-top">
                <span class="label">{post.categoryLabel[lang]}</span>
                <time class="post-stats" datetime={post.published}>{post.published}</time>
              </div>
              {/* vt-card: named only when this card is clicked (scripts/site.ts), so one title flies, not 47. */}
              <h2 class="post-title vt-card" style={`--vt: post-${post.slug}`}>
                <a href={localePath(lang, postPath(post))}>{post.title[lang]}</a>
              </h2>
              <div class="post-takeaway">{post.takeaway[lang]}</div>
            </div>
            <div class="post-actions">
              <a class="text-link" href={localePath(lang, postPath(post))}>{d.writing.readBriefLink}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
