---
// /writing/: page 1 of every post, newest first. The rest are on /writing/page/<n>/, and each
// topic has its own pages (src/data/writing-pages.ts). Home's grid is only the latest six.
import WritingList from '../../../components/WritingList.astro';
import { localeOf, localeStaticPaths } from '../../../i18n';

export const getStaticPaths = localeStaticPaths;
const lang = localeOf(Astro.params.locale);
---

<WritingList lang={lang} topic="all" page={1} />
