---
// /writing/<topic>/page/<n>/: page n (2 and up) of one topic.
import WritingList from '../../../../../components/WritingList.astro';
import { topicPagePaths, type Topic } from '../../../../../data/writing-pages';
import { localeOf } from '../../../../../i18n';

export const getStaticPaths = topicPagePaths;
const lang = localeOf(Astro.params.locale);
---

<WritingList lang={lang} topic={Astro.params.topic as Topic} page={Number(Astro.params.n)} />
