---
// One indexable, shareable page per post: the same brief as the inline reader, plus `body`
// when a post has one (then this page, not LinkedIn, is the original: see blogPostingLd).
import { BLOG_POSTS } from '../../../data/posts';
import { blogPostingLd, postPath, readTimeLabel, type BlogPost } from '../../../data/profile';
import Base from '../../../layouts/Base.astro';
import PostBrief from '../../../components/PostBrief.astro';
import { localeOf, localeParams, localePath, t } from '../../../i18n';

export function getStaticPaths() {
  return localeParams().flatMap((params) =>
    BLOG_POSTS.map((post) => ({
      params: { ...params, slug: post.slug },
      props: { post },
    })),
  );
}

const { post } = Astro.props as { post: BlogPost };
const lang = localeOf(Astro.params.locale);
const d = t(lang);

const SITE = 'https://rossev.dev/';
const PERSON_ID = `${SITE}#person`;
const url = new URL(localePath(lang, postPath(post)), SITE).toString();
const ogImageUrl = new URL('/og-card.png', SITE).toString();
const readTime = readTimeLabel(post);
const title = `${post.title[lang]} — ${d.meta.name}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    blogPostingLd(post, url, ogImageUrl, lang),
    // The full Person node lives on home; this is enough to resolve the @id here.
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Gleb Rosev',
      url: SITE,
      sameAs: ['https://www.linkedin.com/in/rossev/', 'https://github.com/Grumbash']
    }
  ]
};
---

<Base
  title={title}
  description={post.takeaway[lang]}
  ogType="article"
  ogTitle={title}
  jsonLd={jsonLd}
  cta={false}
>
  <meta slot="head" property="article:published_time" content={post.published} />
  <section class="section-block">
    <div class="container" style="max-width: 860px;">
      <a class="text-link" href={localePath(lang, '/writing/')} style="display: inline-block; margin-bottom: 18px;">
        {d.writing.allWriting}
      </a>

      {/* data-quote-*: what the quote bar (scripts/quote.ts) says and shares, in this page's language. */}
      <article
        class="brutal-box post-reader-drawer"
        data-quote-title={post.title[lang]}
        data-quote-url={url}
        data-quote-slug={post.slug}
        data-quote-card={d.quote.card}
        data-quote-link={d.quote.link}
        data-quote-copied={d.quote.copied}
        data-reading-continue={d.reading.continue}
        data-reading-here={d.reading.here}
      >
        <div class="blueprint-header">
          <span>{d.reader.header} {post.categoryLabel[lang]} · {readTime[lang]}</span>
          <time datetime={post.published}>{post.published}</time>
        </div>

        <div style="padding: 22px 24px;">
          {/* vt-title: the card title on /writing/ and the inline brief heading fly into this one. */}
          <h1 class="vt-title" style={`--vt: post-${post.slug}; font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; line-height: 1.15; margin-bottom: 10px;`}>
            {post.title[lang]}
          </h1>
          <p class="post-takeaway" style="font-size: 1rem;">
            {post.takeaway[lang]}
          </p>

          <PostBrief post={post} lang={lang} />
        </div>
      </article>
    </div>
  </section>
  <Fragment slot="scripts">
    <script>
      import { initDepth } from '../../../scripts/depth';
      import { initQuote } from '../../../scripts/quote';
      import { initReading } from '../../../scripts/reading';
      import { initCompanionLoader } from '../../../scripts/companion';
      initDepth();
      initQuote();
      initReading();
      initCompanionLoader();
    </script>
  </Fragment>
</Base>

<style>
  /* Where the reader stopped (scripts/reading.ts): the offer at the bottom, the mark on the paragraph. */
  :global(.reading-pill) {
    position: fixed;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    z-index: 55;
    padding: 10px 16px;
    background: var(--lime);
    color: #0a0a0a;
    border: var(--border-w) solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  :global(.reading-pill[hidden]) {
    display: none;
  }
  .post-reader-drawer :global(.post-body > [data-reading-mark]) {
    position: relative;
    box-shadow: -14px 0 0 var(--lime);
    transition: box-shadow 0.6s;
  }
  .post-reader-drawer :global(.post-body > [data-reading-mark])::before {
    content: attr(data-reading-mark);
    position: absolute;
    top: -1.6em;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ink-muted);
  }
  /* The quote bar over a selected passage, made by scripts/quote.ts at the end of <body>. */
  :global(.quote-bar) {
    position: absolute;
    z-index: 60;
    display: flex;
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  :global(.quote-bar[hidden]) {
    display: none;
  }
  :global(.quote-bar .ctrl-btn) {
    border: 0;
    padding: 8px 12px;
  }
  :global(.quote-bar .ctrl-btn + .ctrl-btn) {
    border-left: var(--border-w) solid var(--border);
  }
  /* The depth dial (PostBrief.astro, scripts/depth.ts): the pressed side reads like the current language. */
  .post-reader-drawer :global(.depth-dial) {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .post-reader-drawer :global(.depth-dial[hidden]) {
    display: none;
  }
  .post-reader-drawer :global(.depth-dial-label) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-muted);
    margin-right: 4px;
  }
  .post-reader-drawer :global(.depth-dial [aria-pressed='true']) {
    background: var(--ink);
    color: var(--bg);
  }
  /* The full text is HTML from bodyHtml (src/data/post-body.ts), so the rules reach into it. */
  .post-reader-drawer :global(.post-body) {
    margin-bottom: 18px;
    line-height: 1.65;
  }
  .post-reader-drawer :global(.post-body p),
  .post-reader-drawer :global(.post-body ul) {
    margin-bottom: 12px;
  }
  .post-reader-drawer :global(.post-body h2) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 28px 0 10px;
  }
  .post-reader-drawer :global(.post-body ul) {
    padding-left: 1.2em;
    list-style: square;
  }
  .post-reader-drawer :global(.post-body li) {
    margin-bottom: 6px;
  }
  .post-reader-drawer :global(.post-body code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 1px 4px;
    background: var(--surface-alt);
  }
  .post-reader-drawer :global(.post-body pre) {
    margin-bottom: 12px;
    padding: 12px 14px;
    overflow-x: auto;
    background: #12151e;
    color: #e8e4dc;
    border-left: 4px solid var(--lime);
    line-height: 1.5;
  }
  .post-reader-drawer :global(.post-body pre code) {
    padding: 0;
    background: none;
    font-size: 0.8rem;
  }
</style>
