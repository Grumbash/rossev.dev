---
// One indexable, shareable page per post: the same brief as the inline reader, plus `body`
// when a post has one (then this page, not LinkedIn, is the original: see blogPostingLd).
import { BLOG_POSTS, blogPostingLd, postPath, readTimeLabel, type BlogPost } from '../../../data/profile';
import Base from '../../../layouts/Base.astro';
import PostBrief from '../../../components/PostBrief.astro';
import { localeOf, localeParams, localePath, t } from '../../../i18n';

export function getStaticPaths() {
  return localeParams().flatMap((params) =>
    BLOG_POSTS.map((post) => ({
      params: { ...params, slug: post.slug },
      props: { post },
    })),
  );
}

const { post } = Astro.props as { post: BlogPost };
const lang = localeOf(Astro.params.locale);
const d = t(lang);

const SITE = 'https://rossev.dev/';
const PERSON_ID = `${SITE}#person`;
const url = new URL(localePath(lang, postPath(post)), SITE).toString();
const ogImageUrl = new URL('/og-card.png', SITE).toString();
const readTime = readTimeLabel(post);
const title = `${post.title[lang]} — ${d.meta.name}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    blogPostingLd(post, url, ogImageUrl, lang),
    // The full Person node lives on home; this is enough to resolve the @id here.
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Gleb Rosev',
      url: SITE,
      sameAs: ['https://www.linkedin.com/in/rossev/', 'https://github.com/Grumbash']
    }
  ]
};
---

<Base
  title={title}
  description={post.takeaway[lang]}
  ogType="article"
  ogTitle={title}
  jsonLd={jsonLd}
  cta={false}
>
  <meta slot="head" property="article:published_time" content={post.published} />
  <section class="section-block">
    <div class="container" style="max-width: 860px;">
      <a class="text-link" href={localePath(lang, '/writing/')} style="display: inline-block; margin-bottom: 18px;">
        {d.writing.allWriting}
      </a>

      <article class="brutal-box post-reader-drawer">
        <div class="blueprint-header">
          <span>{d.reader.header} {post.categoryLabel[lang]} · {readTime[lang]}</span>
          <time datetime={post.published}>{post.published}</time>
        </div>

        <div style="padding: 22px 24px;">
          <h1 style="font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; line-height: 1.15; margin-bottom: 10px;">
            {post.title[lang]}
          </h1>
          <p class="post-takeaway" style="font-size: 1rem;">
            {post.takeaway[lang]}
          </p>

          <PostBrief post={post} lang={lang} />
        </div>
      </article>
    </div>
  </section>
</Base>
