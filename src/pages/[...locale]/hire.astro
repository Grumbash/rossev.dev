---
// Ways to work together (src/data/profile.ts OFFERS), each with the proof already on this site and
// one booking link. No prices: the first step is a call. Gleb is all in on YAGNI, so the offers he
// retired (RETIRED_OFFERS) come first as a diff: struck out, each saying where it went. The JSON-LD
// puts each offer on its provider (YAGNI or Gleb), so search and answer engines say it right.
import Base from '../../layouts/Base.astro';
import CaseQr from '../../components/CaseQr.astro';
import PrintCv from '../../components/PrintCv.astro';
import { OFFERS, PROFILE, RETIRED_OFFERS, type Offer } from '../../data/profile';
import { calUrl } from '../../scripts/analytics';
import { localeOf, localePath, localeStaticPaths, t } from '../../i18n';

export const getStaticPaths = localeStaticPaths;
const lang = localeOf(Astro.params.locale);
const d = t(lang);
const h = d.hire;

const SITE = 'https://rossev.dev/';
const PERSON_ID = `${SITE}#person`;
// The same id as on the home page's worksFor, so the graph joins Gleb to the company.
const YAGNI_ID = 'https://yagni.app/#organization';
const url = new URL(localePath(lang, '/hire/'), SITE).toString();
// Site files (the CV) have one URL for every locale; pages are prefixed.
const proofHref = (href: string) => (/^https?:|\.[a-z]+$/.test(href) ? href : localePath(lang, href));
const external = (href: string) => /^https?:/.test(href);
const offersOf = (by: Offer['by'], provider: string) =>
  OFFERS.filter((o) => o.by === by).map((o) => ({
    '@type': 'Offer',
    url: `${url}#${o.id}`,
    itemOffered: {
      '@type': 'Service',
      name: o.name[lang],
      description: o.forWho[lang],
      provider: { '@id': provider },
      areaServed: 'Worldwide'
    }
  }));
const nameOf = (id: string) => OFFERS.find((o) => o.id === id)?.name[lang] ?? id;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${url}#webpage`,
      url,
      name: d.meta.hireTitle,
      description: d.meta.hireDescription,
      inLanguage: lang,
      isPartOf: { '@id': `${SITE}#website` },
      about: { '@id': PERSON_ID }
    },
    // The full Person node lives on home; here it carries what he offers himself (talks) and who he
    // works for. The pilot is YAGNI's offer, so it sits on the company.
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Gleb Rosev',
      url: SITE,
      sameAs: ['https://www.linkedin.com/in/rossev/', 'https://github.com/Grumbash'],
      worksFor: { '@id': YAGNI_ID },
      makesOffer: offersOf('gleb', PERSON_ID)
    },
    {
      '@type': 'Organization',
      '@id': YAGNI_ID,
      name: 'YAGNI',
      url: 'https://yagni.app',
      makesOffer: offersOf('yagni', YAGNI_ID)
    }
  ]
};
---

<Base title={d.meta.hireTitle} description={d.meta.hireDescription} jsonLd={jsonLd} cta={false}>
  <section class="section-block">
    <div class="container hire-wrap">
      <a class="text-link hire-back" href={localePath(lang, '/')}>{h.home}</a>

      <span class="section-kicker">{h.kicker}</span>
      <h1 class="section-title">{h.title}</h1>
      <p class="hire-lead">{h.lead}</p>

      {/* The retired offers as a diff. Each row keeps its old id, so /hire/#audit still lands here. */}
      <section class="hire-diff" aria-labelledby="hire-diff-title">
        <h2 class="hire-diff-title" id="hire-diff-title">{h.diffTitle}</h2>
        <ul class="hire-diff-rows">
          {RETIRED_OFFERS.map((r) => (
            <li class="hire-diff-row" id={r.id}>
              <p class="hire-diff-del">
                <span class="hire-diff-sign" aria-hidden="true">−</span>
                <span class="visually-hidden">{h.removed}</span>
                <del>{r.was[lang]}</del>
              </p>
              <p class="hire-diff-add">
                <span class="hire-diff-sign" aria-hidden="true">+</span>
                <span class="visually-hidden">{h.added}</span>
                {r.to ? <a class="text-link" href={`#${r.to}`}>{r.now[lang]} →</a> : <span>{r.now[lang]}</span>}
              </p>
            </li>
          ))}
          {OFFERS.filter((o) => o.by === 'gleb').map((o) => (
            <li class="hire-diff-row">
              <p class="hire-diff-ctx">
                <span class="hire-diff-sign" aria-hidden="true"> </span>
                <span><a class="text-link" href={`#${o.id}`}>{o.name[lang]}</a> <span class="hire-diff-note">({h.unchanged})</span></span>
              </p>
            </li>
          ))}
        </ul>
      </section>

      <nav class="hire-jump" aria-label={h.kicker}>
        {OFFERS.map((o) => <a class="text-link" href={`#${o.id}`}>{o.name[lang]}</a>)}
      </nav>

      <div class="hire-offers">
        {OFFERS.map((o) => (
          <article class="brutal-box hire-card" id={o.id}>
            <h2 class="hire-card-title">{o.name[lang]}</h2>
            <dl class="hire-rows">
              <div>
                <dt class="label">{h.forWho}</dt>
                <dd>{o.forWho[lang]}</dd>
              </div>
              <div>
                <dt class="label">{h.youGet}</dt>
                <dd>
                  <ul class="hire-list">
                    {o.youGet[lang].map((item) => <li>{item}</li>)}
                  </ul>
                </dd>
              </div>
              <div>
                <dt class="label">{h.proof}</dt>
                <dd class="hire-proof">
                  {o.proof.map((p) =>
                    external(p.href) ? (
                      <a class="text-link" href={p.href} target="_blank" rel="noopener noreferrer">{p.label[lang]} ↗</a>
                    ) : (
                      <a class="text-link" href={proofHref(p.href)}>{p.label[lang]} →</a>
                    )
                  )}
                </dd>
              </div>
            </dl>
          </article>
        ))}
      </div>

      <div class="hire-cta">
        <div>
          <p class="hire-lead">{h.ctaLead}</p>
          <div class="hero-actions">
            <a
              href={calUrl('hire', lang)}
              data-track="cta_book"
              data-track-placement="hire"
              target="_blank"
              rel="noopener noreferrer"
              class="brutal-btn brutal-btn-lime"
            >
              {h.cta}
            </a>
            {/* The letter starts itself from what this browser read (scripts/letter.ts). */}
            <a
              href={`mailto:${PROFILE.email}?subject=${encodeURIComponent(d.letter.subject)}`}
              class="brutal-btn"
              data-letter
              data-track="email_click"
              data-track-placement="hire"
              {...Object.fromEntries(Object.entries(d.letter).map(([k, v]) => [`data-letter-${k.replace(/[A-Z]/g, (c) => '-' + c.toLowerCase())}`, v]))}
            >
              {d.letter.write}
            </a>
          </div>
          <p class="hire-letter" data-letter-line data-morph-ignore hidden></p>
        </div>
        {/* The case's code, for a laptop or a projector: people move to their phone by scanning it. */}
        <figure class="hire-qr">
          <CaseQr label={h.qrLabel} />
          <figcaption>{h.qrCaption}</figcaption>
        </figure>
      </div>
    </div>
  </section>
  <PrintCv lang={lang} />
</Base>

<script>
  import { initLetter } from '../../scripts/letter';
  initLetter();
</script>

<style>
  .hire-wrap {
    max-width: 860px;
  }
  .hire-letter {
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 62ch;
    margin: 12px 0 0;
    color: var(--ink-muted);
  }
  .hire-back {
    display: block;
    width: fit-content;
    margin-bottom: 18px;
  }
  .hire-lead {
    font-size: 1.05rem;
    line-height: 1.5;
    max-width: 62ch;
    margin: 14px 0 8px;
  }
  /* The retired offers, read like a diff: red removed lines, green added ones, mono like the PR pages. */
  .hire-diff {
    margin: 22px 0 6px;
    border: 2px solid var(--border);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .hire-diff-title {
    margin: 0;
    padding: 8px 14px;
    border-bottom: 2px solid var(--border);
    background: var(--surface-alt);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hire-diff-rows {
    list-style: none;
    margin: 0;
    padding: 6px 0;
  }
  .hire-diff-row {
    scroll-margin-top: 90px;
  }
  .hire-diff-row:target {
    outline: 3px solid var(--lime);
    outline-offset: -3px;
  }
  .hire-diff-row p {
    display: grid;
    grid-template-columns: 1.6ch 1fr;
    gap: 0 8px;
    margin: 0;
    padding: 3px 14px;
    overflow-wrap: anywhere;
  }
  .hire-diff-row p > :not(.hire-diff-sign):not(.visually-hidden) {
    grid-column: 2;
  }
  .hire-diff-del {
    background: color-mix(in srgb, var(--pink) 14%, transparent);
  }
  .hire-diff-del del {
    text-decoration-thickness: 2px;
    color: var(--ink-muted);
  }
  .hire-diff-add {
    background: color-mix(in srgb, var(--lime) 22%, transparent);
  }
  .hire-diff-sign {
    font-weight: 700;
    user-select: none;
  }
  .hire-diff-note {
    color: var(--ink-muted);
  }
  .hire-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 18px 0 28px;
  }
  .hire-offers {
    display: grid;
    gap: 22px;
  }
  .hire-card {
    padding: 18px 20px;
    scroll-margin-top: 90px;
  }
  .hire-card-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  .hire-rows {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .hire-rows > div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 12px;
    border-top: 1px solid var(--surface-alt);
    padding-top: 10px;
  }
  .hire-rows dd {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .hire-list {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .hire-proof {
    display: grid;
    gap: 6px;
    justify-items: start;
  }
  .hire-cta {
    margin-top: 40px;
    border-top: 2px solid var(--border);
    padding-top: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
  }

  .hire-qr {
    margin: 0;
    width: 180px;
    flex: none;
  }

  /* The one rounded box on the site: it is the object from the phone case, round dots and all. */
  .hire-qr :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 2px solid var(--border);
    box-shadow: 4px 4px 0 var(--shadow);
  }

  .hire-qr figcaption {
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  /* Phones have no use for a code they would have to scan with themselves. */
  @media (hover: none), (max-width: 760px) {
    .hire-qr {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hire-rows > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .hire-card {
      padding: 14px;
    }
  }
</style>
