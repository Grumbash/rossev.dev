---
import { PROFILE, CASE_STUDIES, EXPERIENCE, CAPABILITIES, SKILL_USAGE, BLOG_POSTS, latestPosts } from '../../data/profile';
import Base from '../../layouts/Base.astro';
import BlogGrid from '../../components/BlogGrid.astro';
import { calUrl } from '../../scripts/analytics';
import { LOCALES, localeOf, localePath, localeStaticPaths, t } from '../../i18n';
import replay from '../../data/replay-pr11.json';
import { clockTimes } from '../../scripts/replay/director';

export const getStaticPaths = localeStaticPaths;
const lang = localeOf(Astro.params.locale);
const d = t(lang);
const homePath = localePath(lang, '/');
const replayTimes = clockTimes(replay.events);
const ogImageUrl = new URL('/og-card.png', 'https://rossev.dev').toString();

const SITE = 'https://rossev.dev/';
const PERSON_ID = `${SITE}#person`;
const WEBSITE_ID = `${SITE}#website`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': WEBSITE_ID,
      url: SITE,
      name: 'Gleb Rosev',
      inLanguage: LOCALES,
      publisher: { '@id': PERSON_ID },
      about: { '@id': PERSON_ID }
    },
    {
      '@type': 'ProfilePage',
      '@id': `${new URL(homePath, SITE)}#profilepage`,
      url: new URL(homePath, SITE).toString(),
      inLanguage: lang,
      isPartOf: { '@id': WEBSITE_ID },
      mainEntity: { '@id': PERSON_ID }
    },
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Gleb Rosev',
      alternateName: ['Gleb Rossev', 'Глеб Росев'],
      url: SITE,
      image: ogImageUrl,
      jobTitle: 'Founding Engineer, AI Agents',
      worksFor: {
        '@type': 'Organization',
        name: 'YAGNI',
        url: 'https://yagni.app'
      },
      description:
        'Founding Engineer at YAGNI (yagni.app) making AI agent teams dependable in production. Ex-Staff Harness Engineer at Sully.ai (healthcare voice AI).',
      email: 'mailto:rossevgleb@gmail.com',
      knowsAbout: [
        'Agent Teams & Harnesses',
        'Agent Evaluation & Benchmarks',
        'Self-Improving Loops',
        'Sandboxed Code Runners',
        'MCP',
        'RAG Pipelines',
        'Voice AI',
        'Distributed Systems',
        'Multi-Tenant Isolation',
        'Observability',
        'Incident Response',
        'TypeScript',
        'Node.js',
        'React',
        'PostgreSQL',
        'Kubernetes'
      ],
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Belarusian State University' },
      sameAs: ['https://www.linkedin.com/in/rossev/', 'https://github.com/Grumbash']
    }
  ]
};
---

<Base
  home
  htmx
  title={d.meta.homeTitle}
  description={d.meta.homeDescription}
  ogTitle={d.meta.homeOgTitle}
  ogDescription={d.meta.homeOgDescription}
  twitterDescription={d.meta.homeTwitterDescription}
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    {/* Without JS the GR monogram is a static picture: drop the copy and Reset button that invite damage. */}
    <noscript><style>[data-nca-live]{display:none!important}</style></noscript>
  </Fragment>
      <!-- HERO: who, what, how to reach me. Topology stays on the right. -->
      <section class="hero-section container">
        <div class="hero-grid">
          <div class="brutal-box hero-card">
            <h1 class="hero-title">
              {d.hero.firstName} <span class="hero-title-highlight">{d.hero.lastName}</span>
            </h1>

            <p class="hero-value">
              {PROFILE.valueLine[lang]}
              {/* The YAGNI numbers can't be shown here; the same way of working can, on this site's own PRs.
                  Worded so it doesn't read as proof of those numbers. */}
              <a class="text-link hero-value-link" href={localePath(lang, '/how-its-built/')}>{d.hero.buildLoop}</a>
            </p>

            <div class="hero-role">
              {PROFILE.tagline[lang]}
            </div>

            <div class="hero-stats-grid">
              {PROFILE.heroStats.map((st) => (
                <div class="stat-card">
                  <span class="stat-val">{st.value[lang]}</span>
                  <div class="stat-lbl">
                    {st.label[lang]}
                  </div>
                </div>
              ))}
            </div>

            <div class="hero-actions">
              <a
                href={calUrl('hero', lang)}
                data-track="cta_book"
                data-track-placement="hero"
                target="_blank"
                rel="noopener noreferrer"
                class="brutal-btn brutal-btn-lime"
              >
                {d.hero.bookIntro}
              </a>
              <a
                href="/gleb-rosev-cv.pdf"
                target="_blank"
                download="Gleb_Rosev_Founding_Engineer_CV.pdf"
                class="brutal-btn"
                data-track="cv_download"
                data-track-placement="hero"
              >
                {d.hero.downloadCv}
              </a>
            </div>

            <p class="hero-cta-note">
              {d.hero.ctaNote}
            </p>

            <p class="hero-bio">
              {PROFILE.bioShort[lang]}
            </p>

            <p class="hero-summary">
              {PROFILE.summaryThirdPerson[lang]}
            </p>

            <dl class="contact-list">
              <div class="contact-row">
                <dt class="label">Email</dt>
                <dd>
                  <a class="text-link" href={`mailto:${PROFILE.email}`} data-track="email_click" data-track-placement="hero">{PROFILE.email}</a>
                  <button
                    type="button"
                    class="copy-btn"
                    data-action="copy" data-copy={PROFILE.email}
                    data-track="email_copy"
                    data-track-placement="hero"
                  >
                    {d.hero.copy}
                  </button>
                </dd>
              </div>
              <div class="contact-row">
                <dt class="label">LinkedIn</dt>
                <dd><a class="text-link" href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" data-track="linkedin_click" data-track-placement="hero">in/rossev ↗</a></dd>
              </div>
              <div class="contact-row">
                <dt class="label">GitHub</dt>
                <dd><a class="text-link" href={PROFILE.github} target="_blank" rel="noopener noreferrer">Grumbash ↗</a></dd>
              </div>
            </dl>
            <div class="contact-meta">
              <span>{PROFILE.languages.map((l) => l[lang]).join(', ')}</span>
              <span aria-hidden="true">·</span>
              <span>{PROFILE.location[lang]} · {d.hero.remote} · {PROFILE.timezone}</span>
            </div>

            <div class="med-twist-box">
              {PROFILE.medToAiStory[lang]}
            </div>
          </div>

          <!-- Right: Deep Interactive 3D System Topology & Architecture Engine -->
          <div class="brutal-box stage-iso-card">
            <div class="stage-header">
              <span>
                {d.topology.title}
              </span>
              <span class="replay-badge" data-replay-badge>{d.topology.replayBadge}</span>
              <span id="iso-trace-status"></span>
            </div>

            {/* The card plays a replay of a real agent run on this site (src/scripts/replay/player.ts,
                 loaded after first paint). Its captions are drawn on the canvas; screen readers hear
                 them from the live region. The take-over controls work from the first click. */}
            <div class="iso-story">
              <p class="visually-hidden" aria-live="polite" data-replay-live></p>
              <a class="replay-label" data-replay-label href={replay.url} target="_blank" rel="noopener noreferrer">{replay.label[lang]}</a>
              <div class="iso-story-controls">
                <button type="button" class="mode-btn mode-btn-fault" data-sim-fault>{d.topology.injectFault}</button>
                <button type="button" class="mode-btn" data-sim-judge aria-pressed="true">
                  {d.topology.judge}: <span data-sim-judge-state>{d.topology.judgeOn}</span>
                </button>
                <button
                  type="button"
                  class="mode-btn iso-story-explore"
                  data-story-explore
                  aria-expanded="false"
                  aria-controls="iso-explore"
                  data-track="topology_interact"
                  data-track-action="explore"
                >
                  {d.topology.explore}
                </button>
              </div>
              <a
                class="iso-story-case"
                data-story-case
                href={`${homePath}?case=yagni#case-yagni`}
                data-track="topology_interact"
                data-track-action="case"
              >
                {d.topology.caseLink}
              </a>
            </div>

            {/* Free play (behind Explore): Domain Switcher & 3D Engine Modes */}
            <div class="arch-tabs-bar" id="iso-explore" hidden>
              <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                <button
                  type="button"
                  class="mode-btn active"
                  data-iso-domain="yagni"
                  data-action="setIsoDomain" data-arg="yagni"
                  data-track="topology_interact"
                  data-track-action="domain"
                >
                  {d.topology.domainYagni}
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  data-iso-domain="voice"
                  data-action="setIsoDomain" data-arg="voice"
                  data-track="topology_interact"
                  data-track-action="domain"
                >
                  {d.topology.domainVoice}
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  data-iso-domain="saas"
                  data-action="setIsoDomain" data-arg="saas"
                  data-track="topology_interact"
                  data-track-action="domain"
                >
                  {d.topology.domainSaas}
                </button>
              </div>

              <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                <button
                  type="button"
                  class="mode-btn mode-btn-fault"
                  id="btn-iso-fault"
                  data-action="triggerIsoFault"
                  data-track="topology_interact"
                  data-track-action="fault"
                >
                  {d.topology.fault}
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  id="btn-iso-xray"
                  data-action="toggleIsoXray"
                  data-track="topology_interact"
                  data-track-action="xray"
                >
                  {d.topology.xray}
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  id="btn-iso-reset"
                  data-action="resetIsoCamera"
                  data-track="topology_interact"
                  data-track-action="reset"
                >
                  {d.topology.overview}
                </button>
                <button
                  type="button"
                  class="mode-btn active"
                  data-action="fireIsoPacket"
                  data-track="topology_interact"
                  data-track-action="packet"
                >
                  {d.topology.trace}
                </button>
              </div>
              <span class="iso-hint-fine">DRAG · CTRL/⌘+SCROLL · CLICK A NODE</span>
            </div>

            {/* Deep 3D Spatial Canvas (3 Vertical Strata + Exploded Node Inspector) */}
            <div class="iso-canvas-container" id="iso-canvas-wrap">
              <canvas
                id="iso-arch-canvas"
                tabindex="0"
                role="application"
                aria-label="Interactive 3D System Architecture Topology. Use Left and Right arrow keys to cycle nodes, Enter to explode node layers, F to simulate fault."
              ></canvas>

              {/* Offered when the visitor has left the film alone for a while. Over the canvas, so it
                   moves nothing when it appears. */}
              <button type="button" class="mode-btn active iso-resume" data-replay-resume hidden>{d.topology.resume}</button>

              {/* Phones: the canvas is a still poster until this is pressed (no rAF loop before it) */}
              <button
                type="button"
                class="mode-btn active iso-play"
                data-story-play
                data-track="topology_interact"
                data-track-action="play"
              >
                {d.topology.play}
              </button>

              {/* Vertical Depth Deck Slicer (Top-Right) */}
              <div class="iso-stratum-rail">
                <button
                  type="button"
                  class="iso-stratum-btn active"
                  data-stratum-btn="all"
                  data-action="setIsoStratum" data-arg="all"
                  data-track="topology_interact"
                  data-track-action="stratum"
                >
                  {d.topology.strataAll}
                </button>
                <button
                  type="button"
                  class="iso-stratum-btn"
                  data-stratum-btn="1"
                  data-action="setIsoStratum" data-arg="1"
                  data-track="topology_interact"
                  data-track-action="stratum"
                >
                  {d.topology.stratumTop}
                </button>
                <button
                  type="button"
                  class="iso-stratum-btn"
                  data-stratum-btn="0"
                  data-action="setIsoStratum" data-arg="0"
                  data-track="topology_interact"
                  data-track-action="stratum"
                >
                  {d.topology.stratumCore}
                </button>
                <button
                  type="button"
                  class="iso-stratum-btn"
                  data-stratum-btn="-1"
                  data-action="setIsoStratum" data-arg="-1"
                  data-track="topology_interact"
                  data-track-action="stratum"
                >
                  {d.topology.stratumVault}
                </button>
              </div>

              {/* Interactive Node Dossier Overlay (Appears when a 3D building is clicked/exploded) */}
              <div class="iso-inspector-card" id="iso-inspector-card">
                <div class="iso-insp-head">
                  <span class="iso-insp-title" id="iso-insp-title">02 · AGENT CORE</span>
                  <button type="button" class="iso-insp-close" data-action="resetIsoCamera" data-track="topology_interact" data-track-action="reset">×</button>
                </div>
                <div id="iso-insp-sub" style="font-size: 0.72rem; color: #B8C0D4; margin-bottom: 6px;"></div>
                <div class="iso-insp-layers" id="iso-insp-layers"></div>
                <div class="iso-insp-guard" id="iso-insp-guard"></div>
                <div class="iso-insp-actions">
                  <button type="button" class="iso-insp-btn" data-action="stepIsoNode" data-arg="-1" data-track="topology_interact" data-track-action="step">
                    {d.topology.prevNode}
                  </button>
                  <button type="button" class="iso-insp-btn iso-insp-btn-fault" data-action="triggerIsoFault" data-arg="keep-focus" data-track="topology_interact" data-track-action="fault">
                    {d.topology.faultHeal}
                  </button>
                  <button type="button" class="iso-insp-btn" data-action="stepIsoNode" data-arg="1" data-track="topology_interact" data-track-action="step">
                    {d.topology.nextNode}
                  </button>
                </div>
              </div>
            </div>

            {/* Pause (WCAG 2.2.2), then one stop per event of the run, labelled with its real time on Gleb's
                 clock. Five events share a minute, so the stops are evenly spaced: the spacing is the film's,
                 not the run's. A scrub pauses the film where it lands. */}
            <div class="replay-bar">
              <button type="button" class="replay-pause" data-replay-pause aria-pressed="false" aria-label={d.topology.pause}>
                <span aria-hidden="true"></span>
              </button>
              <div
                class="replay-timeline"
                role="slider"
                tabindex="0"
                data-replay-timeline
                aria-valuemin="0"
                aria-valuemax={replay.events.length - 1}
                aria-valuenow="0"
                aria-label={d.topology.timeline}
              >
                {replayTimes.map((time, i) => (
                  <span class="replay-stop" data-replay-stop aria-hidden="true">
                    <i></i>{time === replayTimes[i - 1] ? <b class="is-same">{time}</b> : <b>{time}</b>}
                  </span>
                ))}
              </div>
            </div>

            {/* Clean Bottom Specification Bar */}
            <div class="iso-bottom-hud">
              <div class="iso-layer-spec">
                <span class="iso-spec-pill" id="iso-hud-badge">02 · AGENT CORE</span>
                <span id="iso-hud-text" style="font-weight: 700;">
                  Named AI Agent Team (PM, Builder, Reviewer, Judge) under Human Plan
                </span>
              </div>
              <button
                type="button"
                class="mode-btn"
                style="padding: 3px 9px; font-size: 0.68rem;"
                data-action="openDomainBlueprint"
                data-track="topology_interact"
                data-track-action="blueprint"
              >
                {d.topology.blueprint}
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- EXPERIENCE: one chronology. Each job carries its story, numbers, stack and architecture. -->
      <section id="experience" class="section-block">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="section-kicker">
                {d.experience.kicker}
              </span>
              <h2 class="section-title">
                {d.experience.title}
              </h2>
            </div>
          </div>

          <div class="toolbox" id="toolbox">
            <div class="toolbox-intro">
              <div>
                <span class="label">
                  {d.toolbox.label}
                </span>
                <p class="toolbox-lead">
                  {d.toolbox.lead}
                  <a class="text-link" href="/llms.txt" target="_blank">/llms.txt</a>.
                </p>
              </div>
              <button type="button" class="brutal-btn brutal-btn-sm" data-action="copyToolbox" data-track="toolbox_copy">
                {d.toolbox.copy}
              </button>
            </div>

            {CAPABILITIES.map((cap) => (
              <div class="toolbox-row" data-toolbox-row>
                <span class="toolbox-head">
                  {cap.title[lang]}
                </span>
                <span class="toolbox-skills">
                  {cap.skills.map((skill) =>
                    SKILL_USAGE[skill] ? (
                      <button
                        type="button"
                        class="skill-link"
                        data-skill={skill}
                        data-track="skill_click"
                        data-track-skill={skill}
                        data-jobs={SKILL_USAGE[skill].join(' ')}
                        aria-pressed="false"
                        aria-controls="experience-timeline"
                        data-action="selectSkill"
                      >
                        {skill}
                      </button>
                    ) : (
                      <span class="skill-plain">{skill}</span>
                    )
                  )}
                </span>
              </div>
            ))}

            <div class="toolbox-result" id="toolbox-result" aria-live="polite" data-used-at={d.toolbox.usedAt} data-clear={d.toolbox.clear} hidden></div>
          </div>

          <ol class="timeline" id="experience-timeline">
            {EXPERIENCE.map((exp, idx) => {
              const cs = CASE_STUDIES.find((c) => c.id === exp.caseId);
              const numbers = cs ? cs.metrics.filter((m) => /\d/.test(m.value.en)) : [];
              return (
                <li class="brutal-box job-card" id={exp.id} data-company={exp.company}>
                  <div class="job-head">
                    <div>
                      <div class="job-company">
                        {exp.url ? (
                          <a class="text-link" href={exp.url} target="_blank" rel="noopener noreferrer">
                            {exp.company} ↗
                          </a>
                        ) : (
                          <span>{exp.company}</span>
                        )}
                        {idx === 0 && (
                          <span class="label label-now">
                            {d.experience.now}
                          </span>
                        )}
                      </div>
                      <h3 class="job-role">
                        {exp.role[lang]}
                      </h3>
                    </div>
                    <div class="job-meta">
                      <div>
                        {exp.period[lang]}
                      </div>
                      <div>
                        {exp.location[lang]}
                      </div>
                    </div>
                  </div>

                  <p class="job-domain">
                    {exp.domain[lang]}
                  </p>

                  {numbers.length > 0 && (
                    <div class="job-metrics">
                      {numbers.map((m) => (
                        <div class="job-metric">
                          <span class="job-metric-val">{m.value[lang]}</span>
                          <span class="job-metric-lbl">
                            {m.label[lang]}
                          </span>
                        </div>
                      ))}
                    </div>
                  )}

                  <ul class="exp-bullets">
                    {exp.highlights[lang].map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>

                  <div class="job-stack">
                    <span class="label">{d.experience.stack}</span>
                    {exp.stack.map((tech) => (
                      <span class="brutal-tag">{tech}</span>
                    ))}
                  </div>

                  {cs && (
                    <details class="job-case" id={`case-${cs.id}`} data-case-src={localePath(lang, `/partials/case-${cs.id}`)}>
                      <summary class="brutal-btn">
                        {d.experience.breakdown}
                      </summary>
                      {/* The breakdown loads on first open (src/scripts/case-loader.ts); until then, and without JS, a link to its page */}
                      <div data-case-body>
                        <a class="text-link" href={localePath(lang, `/cases/${cs.id}/`)}>{d.experience.openBreakdown(cs.company)}</a>
                      </div>
                    </details>
                  )}
                </li>
              );
            })}
          </ol>

        </div>
      </section>

      <!-- BEYOND THE CV: essays live in their own visual zone -->
      <div class="zone-beyond">
        <div class="container">
          <div class="zone-divider">
            {d.writing.beyond}
          </div>
        </div>

        {/* GR monogram: a neural cellular automaton. The static SVG (scripts/nca/train.py
            --fallback-svg) holds its place until src/scripts/nca/loader.ts lazy-loads the
            model, which never happens on Save-Data/2G; the canvas replaces it on the first frame. */}
        <section class="nca-section" aria-labelledby="nca-heading">
          <div class="container">
            <h2 id="nca-heading" class="visually-hidden">
              {d.nca.heading}
            </h2>
            <div class="nca-block">
              <canvas
                id="nca-canvas"
                class="nca-canvas"
                width="56"
                height="56"
                tabindex="0"
                role="button"
                aria-labelledby="nca-label"
                aria-describedby="nca-caption"
                hidden
              ></canvas>
              <svg class="nca-canvas nca-fallback" viewBox="0 0 112 112" width="56" height="56" aria-hidden="true"><rect x="56" y="24" width="46" height="64" fill="#C8FF00"/><path fill="#0A0A0A" d="M28 82Q23 82 19 80Q15 77 12 73Q10 68 10 62V50Q10 40 15 35Q21 30 30 30Q39 30 44 35Q49 40 49 48V48H40V48Q40 45 39 43Q38 41 36 40Q34 38 30 38Q25 38 22 42Q19 45 19 50V62Q19 67 22 71Q25 74 30 74Q35 74 38 71Q40 68 40 64V63H28V55H49V81H41V76H39Q39 77 38 79Q37 80 34 81Q32 82 28 82ZM60 81V31H82Q86 31 90 33Q93 34 95 37Q97 40 97 44V45Q97 50 95 52Q93 55 90 57V58Q93 58 94 60Q96 62 96 65V81H86V66Q86 64 86 63Q85 62 83 62H69V81ZM69 54H81Q84 54 86 52Q88 50 88 47V46Q88 43 86 41Q84 40 81 40H69Z"/></svg>
              {/* Polite live region for the worker's notices; monogram.ts shows it over the canvas. */}
              <p class="nca-notice" aria-live="polite" data-regrowing={d.nca.regrowing} data-nca-live hidden></p>
              <span id="nca-label" class="visually-hidden">
                {d.nca.label}<span data-nca-live>{d.nca.labelLive}</span>
              </span>
              <div>
                <p id="nca-caption">
                  {d.nca.caption} <span data-nca-live>{d.nca.captionLive}</span><span data-nca-paused hidden>{d.nca.captionPaused}</span>
                </p>
                <p class="nca-bridge">
                  {d.nca.bridge} <a class="text-link" href={`${homePath}?case=yagni#case-yagni`} data-track="nca_interact" data-track-action="case">{d.nca.bridgeLink}</a>
                </p>
                <p class="fine-print" set:html={d.nca.howHtml} />
                <button
                  type="button"
                  id="nca-reset"
                  class="brutal-btn brutal-btn-sm"
                  data-track="nca_interact"
                  data-track-action="reset"
                  data-nca-live
                >
                  {d.nca.reset}
                </button>
              </div>
            </div>
          </div>
        </section>

        <section id="writing" class="section-block">
          <div class="container">
            <div class="section-head">
              <div>
                <span class="section-kicker">
                  {d.writing.kicker}
                </span>
                <h2 class="section-title">
                  {d.writing.title}
                </h2>
              </div>
              <a
                href={PROFILE.linkedin}
                data-track="linkedin_click"
                data-track-placement="writing"
                target="_blank"
                rel="noopener noreferrer"
                class="brutal-btn"
              >
                {d.writing.follow}
              </a>
            </div>

            <div class="filter-bar" role="group" aria-label={d.writing.filterLabel}>
              <button
                type="button"
                class="filter-tab active"
                aria-pressed="true"
                hx-get={localePath(lang, "/partials/posts-all")}
                data-track="post_filter"
                data-track-filter="all"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                data-action="activateFilterBtn"
              >
                {d.writing.filterAll}
              </button>
              <button
                type="button"
                class="filter-tab"
                aria-pressed="false"
                hx-get={localePath(lang, "/partials/posts-ai")}
                data-track="post_filter"
                data-track-filter="ai"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                data-action="activateFilterBtn"
              >
                {d.writing.filterAi}
              </button>
              <button
                type="button"
                class="filter-tab"
                aria-pressed="false"
                hx-get={localePath(lang, "/partials/posts-leadership")}
                data-track="post_filter"
                data-track-filter="leadership"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                data-action="activateFilterBtn"
              >
                {d.writing.filterLeadership}
              </button>
              <button
                type="button"
                class="filter-tab"
                aria-pressed="false"
                hx-get={localePath(lang, "/partials/posts-systems")}
                data-track="post_filter"
                data-track-filter="systems"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                data-action="activateFilterBtn"
              >
                {d.writing.filterSystems}
              </button>
              <button
                type="button"
                class="filter-tab"
                aria-pressed="false"
                hx-get={localePath(lang, "/partials/posts-delivery")}
                data-track="post_filter"
                data-track-filter="delivery"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                data-action="activateFilterBtn"
              >
                {d.writing.filterDelivery}
              </button>
            </div>

            <!-- HTMX On-Site Post Reader Slot -->
            <div id="post-reader-slot" aria-live="polite"></div>

            <div id="blog-posts-container" aria-live="polite">
              <BlogGrid posts={latestPosts(BLOG_POSTS)} lang={lang} />
            </div>

            <div class="writing-more">
              <a class="brutal-btn" href={localePath(lang, '/writing/')}>{d.writing.allPosts(BLOG_POSTS.length)}</a>
            </div>
          </div>
        </section>
      </div>

  <Fragment slot="scripts">
    <!-- Bundled page code: the topology's loader (engine and replay are lazy), case loader, post reader, toolbox -->
    <script>
      import { initTopologyReplay } from '../../scripts/topology-replay';
      import { initCaseLoader } from '../../scripts/case-loader';
      import { initHome } from '../../scripts/home';
      initHome();
      initCaseLoader();
      document.addEventListener('DOMContentLoaded', () => {
        initTopologyReplay();
      });
    </script>
    {/* GR monogram: a tiny loader; the model, worker and their CSS load near the block */}
    <script>
      import { initNcaLoader } from '../../scripts/nca/loader';
      initNcaLoader();
    </script>
  </Fragment>
</Base>
