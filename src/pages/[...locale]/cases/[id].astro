---
// Each architecture case as its own indexable page; home's timeline loads the same breakdown inline.
import { CASE_STUDIES, EXPERIENCE } from '../../../data/profile';
import Base from '../../../layouts/Base.astro';
import CaseBlueprint from '../../../components/CaseBlueprint.astro';
import { localeOf, localeParams, localePath, t } from '../../../i18n';

export function getStaticPaths() {
  return localeParams().flatMap((params) =>
    CASE_STUDIES.flatMap((study) => {
      const job = EXPERIENCE.find((e) => e.caseId === study.id);
      return job ? [{ params: { ...params, id: study.id }, props: { study, job } }] : [];
    }),
  );
}

const { study, job } = Astro.props;
const lang = localeOf(Astro.params.locale);
const d = t(lang);
---

<Base
  title={`${study.title[lang]} · ${d.meta.name}`}
  description={d.meta.caseDescription(study.company, study.period, study.summary[lang])}
  ogType="article"
>
  <section class="section-block">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-kicker">{d.casePage.kicker(study.company)}</span>
          <h1 class="section-title">{study.title[lang]}</h1>
          <p>{study.summary[lang]}</p>
        </div>
      </div>

      <CaseBlueprint study={study} lang={lang} />

      <p class="case-back">
        <a class="text-link" href={`${localePath(lang, '/')}#${job.id}`}>{d.casePage.back(job.company)}</a>
      </p>
    </div>
  </section>
</Base>
