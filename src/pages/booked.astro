---
// cal.com's "Redirect on booking" target. The redirect forwards our utm_content plus the booking itself
// (uid, email, name, phone...). The head script keeps only the placement on <html data-booking-source>
// (initAnalytics sends booking_confirmed) and strips the query before Umami and Vercel read the URL.
import { BLOG_POSTS, PROFILE, postPath } from '../data/profile';
import Base from '../layouts/Base.astro';
import { PLACEMENTS, bookingSource } from '../scripts/analytics';

const SITE = 'https://rossev.dev/';
const url = new URL('/booked/', Astro.site || SITE).toString();
const post = BLOG_POSTS.find((p) => p.slug === 'the-new-ai-bottleneck')!;

// Classic and inline, so it runs during parsing, before the deferred trackers. It is bookingSource() itself:
// its source is inlined, with PLACEMENTS declared beside it for its default argument.
const strip = `(function () {
  var q = location.search;
  if (!q) return;
  try {
    var PLACEMENTS = ${JSON.stringify(PLACEMENTS)};
    var s = (${bookingSource.toString()})(q);
    if (s) document.documentElement.setAttribute('data-booking-source', s);
  } catch (e) {}
  try { history.replaceState(history.state, '', location.pathname + location.hash); } catch (e) {}
})();`;
---

<Base
  title="Booked — Gleb Rosev"
  description="Your call with Gleb Rosev is booked. A calendar invite from cal.com is on its way."
  canonical={url}
  cta={false}
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
    <script is:inline set:html={strip} />
  </Fragment>

  <section class="section-block">
    <div class="container">
      <span class="section-kicker">
        <span class="lang-en">Booked</span>
        <span class="lang-ru">Готово</span>
      </span>
      <h1 class="section-title">
        <span class="lang-en">Booked — talk soon.</span>
        <span class="lang-ru">Забронировано — до связи.</span>
      </h1>
      <p class="footer-lead">
        <span class="lang-en">A calendar invite from cal.com is on its way. Before we talk:</span>
        <span class="lang-ru">Приглашение придёт от cal.com. Пока ждёшь:</span>
      </p>
      <div class="footer-links">
        <a class="text-link" href="/?case=yagni#experience">
          <span class="lang-en">How I build AI agent teams at YAGNI →</span>
          <span class="lang-ru">Как я строю команды AI-агентов в YAGNI →</span>
        </a>
        <a class="text-link" href={postPath(post)}>
          <span class="lang-en">{post.title.en} →</span>
          <span class="lang-ru">{post.title.ru} →</span>
        </a>
        <a class="text-link" href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
      <p class="footer-lead">
        <span class="lang-en">Reply to the invite with what you’re hiring for — I’ll come prepared.</span>
        <span class="lang-ru">Ответь на приглашение, кого ищешь, — подготовлюсь.</span>
      </p>
    </div>
  </section>
</Base>
