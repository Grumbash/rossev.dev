---
// Every post page in one crawlable list. Home's grid is the same list with filters and the inline reader.
import { BLOG_POSTS, postPath } from '../../data/profile';
import Base from '../../layouts/Base.astro';

const SITE = 'https://rossev.dev/';
const url = new URL('/writing/', Astro.site || SITE).toString();
const posts = [...BLOG_POSTS].sort((a, b) => b.published.localeCompare(a.published));
---

<Base
  title="Writing — Gleb Rosev"
  description="Field notes by Gleb Rosev on production AI agents, systems and engineering leadership: 30-second briefs of his LinkedIn posts, in English and Russian."
  canonical={url}
>
  <section class="section-block">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-kicker">
            <span class="lang-en">Writing</span>
            <span class="lang-ru">Блог</span>
          </span>
          <h1 class="section-title">
            <span class="lang-en">Field notes on AI, systems & leadership</span>
            <span class="lang-ru">Заметки об AI, системах и менеджменте</span>
          </h1>
        </div>
      </div>

      <div class="posts-grid">
        {posts.map((post) => (
          <article class="brutal-box post-card">
            <div>
              <div class="post-top">
                <span class="label">
                  <span class="lang-en">{post.categoryLabel.en}</span>
                  <span class="lang-ru">{post.categoryLabel.ru}</span>
                </span>
                <time class="post-stats" datetime={post.published}>{post.published}</time>
              </div>
              <h2 class="post-title">
                <a href={postPath(post)}>
                  <span class="lang-en">{post.title.en}</span>
                  <span class="lang-ru">{post.title.ru}</span>
                </a>
              </h2>
              <div class="post-takeaway">
                <span class="lang-en">{post.takeaway.en}</span>
                <span class="lang-ru">{post.takeaway.ru}</span>
              </div>
            </div>
            <div class="post-actions">
              <a class="text-link" href={postPath(post)}>
                <span class="lang-en">Read brief →</span>
                <span class="lang-ru">Читать разбор →</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
