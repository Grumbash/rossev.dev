---
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/syne/wght.css';
import '../styles/brutalism.css';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import groteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import syneLatin from '@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url';
import { PROFILE, CASE_STUDIES, EXPERIENCE, CAPABILITIES, SKILL_USAGE, BLOG_POSTS } from '../data/profile';
import BlogGrid from '../components/BlogGrid.astro';
import CaseBlueprint from '../components/CaseBlueprint.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { calUrl } from '../scripts/analytics';

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://rossev.dev').toString();
const ogImageUrl = new URL('/og-card.png', Astro.site || 'https://rossev.dev').toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Gleb Rosev',
  jobTitle: 'Founding Engineer, AI Agents',
  worksFor: {
    '@type': 'Organization',
    name: 'YAGNI',
    url: 'https://yagni.app'
  },
  description:
    'Founding Engineer at YAGNI (yagni.app) making AI agent teams dependable in production. Ex-Staff Harness Engineer at Sully.ai (healthcare voice AI).',
  email: 'mailto:rossevgleb@gmail.com',
  sameAs: ['https://www.linkedin.com/in/rossev/', 'https://github.com/Grumbash']
};
---

<!DOCTYPE html>
<html lang="en" data-lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gleb Rosev — Founding Engineer @ YAGNI | AI Agent Teams, Architecture & Reliability</title>
    <meta
      name="description"
      content="Gleb Rosev — Founding Engineer at YAGNI (yagni.app) making AI agent teams dependable in production. 8+ years building distributed systems, Voice AI (Sully.ai), and leading engineering teams."
    />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon, Manifest & AI Crawler Discovery -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI Agent & LLM Context (/llms.txt)" />

    <!-- Open Graph / Telegram / Slack / LinkedIn / X Cards (Raster PNG 1200x630) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Gleb Rosev — Founding Engineer @ YAGNI (yagni.app)" />
    <meta
      property="og:description"
      content="Making AI agent teams dependable in production, not just impressive in a demo. Agent benchmarks, self-improving loops, healthcare Voice AI & distributed systems."
    />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Gleb Rosev — Founding Engineer @ YAGNI (yagni.app)" />
    <meta
      name="twitter:description"
      content="Making AI agent teams dependable in production, not just impressive in a demo."
    />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Self-hosted fonts (no third-party round trip before first paint) -->
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={syneLatin} as="font" type="font/woff2" crossorigin />

    <!-- Structured Data (JSON-LD Person Schema) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Synchronous Anti-FOUC Theme & Language Initialization -->
    <script is:inline>
      (function () {
        try {
          var savedLang = localStorage.getItem('rosev_lang') || 'en';
          document.documentElement.setAttribute('data-lang', savedLang);
          document.documentElement.setAttribute('lang', savedLang);
          var savedTheme = localStorage.getItem('rosev_theme');
          if (savedTheme) {
            document.documentElement.setAttribute('data-theme', savedTheme);
          }
        } catch (e) {}
      })();
    </script>

    <script src="/htmx.min.js" defer></script>

    <!-- Umami Cloud: custom funnel events (see README "Analytics") -->
    {import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        data-domains="rossev.dev"
      ></script>
    )}
  </head>
  <body>
    <!-- TOP NAV: text links scroll, buttons act -->
    <header class="top-nav">
      <div class="nav-inner">
        <a href="#top" class="brand-logo">
          <span class="brand-badge">GR</span>
          <span>GLEB ROSEV</span>
        </a>

        <nav class="nav-links" aria-label="Sections">
          <a class="nav-link" href="#experience">
            <span class="lang-en">Experience</span>
            <span class="lang-ru">Опыт</span>
          </a>
          <a class="nav-link" href="#writing">
            <span class="lang-en">Writing</span>
            <span class="lang-ru">Блог</span>
          </a>
          <a class="nav-link" href="#contact">
            <span class="lang-en">Contact</span>
            <span class="lang-ru">Контакты</span>
          </a>
        </nav>

        <div class="nav-controls">
          <button
            type="button"
            class="ctrl-btn active-lang"
            id="btn-lang-en"
            onclick="window.setSiteLang('en')"
            data-track="lang_switch"
            data-track-to="en"
            aria-label="Switch language to English"
          >
            EN
          </button>
          <button
            type="button"
            class="ctrl-btn"
            id="btn-lang-ru"
            onclick="window.setSiteLang('ru')"
            data-track="lang_switch"
            data-track-to="ru"
            aria-label="Switch language to Russian"
          >
            RU
          </button>
          <button
            type="button"
            class="ctrl-btn"
            id="btn-theme-toggle"
            onclick="window.toggleSiteTheme()"
            data-track="theme_switch"
            title="Toggle Light / Dark Mode"
          >
            <span class="lang-en">THEME</span>
            <span class="lang-ru">ТЕМА</span>
          </button>
          <a
            href={calUrl('nav')}
            data-track="cta_book"
            data-track-placement="nav"
            target="_blank"
            rel="noopener noreferrer"
            class="brutal-btn brutal-btn-lime brutal-btn-sm"
          >
            <span class="lang-en">BOOK A CALL ↗</span>
            <span class="lang-ru">СОЗВОН ↗</span>
          </a>
        </div>
      </div>
    </header>

    <main id="top">
      <!-- HERO: who, what, how to reach me. Topology stays on the right. -->
      <section class="hero-section container">
        <div class="hero-grid">
          <div class="brutal-box hero-card">
            <div>
              <h1 class="hero-title">
                <span class="lang-en">GLEB <span class="hero-title-highlight">ROSEV</span></span>
                <span class="lang-ru">ГЛЕБ <span class="hero-title-highlight">РОСЕВ</span></span>
              </h1>

              <div class="hero-role">
                <span class="lang-en">{PROFILE.tagline.en}</span>
                <span class="lang-ru">{PROFILE.tagline.ru}</span>
              </div>

              <p class="hero-bio">
                <span class="lang-en">{PROFILE.bio.en}</span>
                <span class="lang-ru">{PROFILE.bio.ru}</span>
              </p>

              <div class="med-twist-box">
                <span class="lang-en">{PROFILE.medToAiStory.en}</span>
                <span class="lang-ru">{PROFILE.medToAiStory.ru}</span>
              </div>

              <div class="hero-actions">
                <a
                  href={calUrl('hero')}
                  data-track="cta_book"
                  data-track-placement="hero"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="brutal-btn brutal-btn-lime"
                >
                  <span class="lang-en">BOOK A 30-MIN CALL ↗</span>
                  <span class="lang-ru">ЗАБРОНИРОВАТЬ СОЗВОН ↗</span>
                </a>
                <a
                  href="/gleb-rosev-cv.pdf"
                  target="_blank"
                  download="Gleb_Rosev_Staff_Engineer_CV.pdf"
                  class="brutal-btn"
                  data-track="cv_download"
                  data-track-placement="hero"
                >
                  <span class="lang-en">DOWNLOAD CV ↓</span>
                  <span class="lang-ru">СКАЧАТЬ CV ↓</span>
                </a>
              </div>

              <dl class="contact-list">
                <div class="contact-row">
                  <dt class="label">Email</dt>
                  <dd>
                    <a class="text-link" href={`mailto:${PROFILE.email}`} data-track="email_click" data-track-placement="hero">{PROFILE.email}</a>
                    <button
                      type="button"
                      class="copy-btn"
                      onclick={`window.copyToClipboard('${PROFILE.email}')`}
                      data-track="email_copy"
                      data-track-placement="hero"
                    >
                      <span class="lang-en">copy</span><span class="lang-ru">копировать</span>
                    </button>
                  </dd>
                </div>
                <div class="contact-row">
                  <dt class="label">LinkedIn</dt>
                  <dd><a class="text-link" href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" data-track="linkedin_click" data-track-placement="hero">in/rossev ↗</a></dd>
                </div>
                <div class="contact-row">
                  <dt class="label">GitHub</dt>
                  <dd><a class="text-link" href={PROFILE.github} target="_blank" rel="noopener noreferrer">Grumbash ↗</a></dd>
                </div>
                <div class="contact-row">
                  <dt class="label"><span class="lang-en">Phone</span><span class="lang-ru">Телефон</span></dt>
                  <dd><a class="text-link" href={`tel:${PROFILE.phone.replace(/\s/g, '')}`}>{PROFILE.phone}</a></dd>
                </div>
                <div class="contact-row">
                  <dt class="label"><span class="lang-en">Languages</span><span class="lang-ru">Языки</span></dt>
                  <dd>
                    <span class="lang-en">{PROFILE.languages.map((l) => l.en).join(' · ')}</span>
                    <span class="lang-ru">{PROFILE.languages.map((l) => l.ru).join(' · ')}</span>
                  </dd>
                </div>
                <div class="contact-row">
                  <dt class="label"><span class="lang-en">Based</span><span class="lang-ru">Где</span></dt>
                  <dd>
                    <span class="lang-en">{PROFILE.location.en} · Remote · {PROFILE.timezone}</span>
                    <span class="lang-ru">{PROFILE.location.ru} · удалённо · {PROFILE.timezone}</span>
                  </dd>
                </div>
              </dl>
            </div>

            <div class="hero-stats-grid">
              {PROFILE.heroStats.map((st) => (
                <div class="stat-card">
                  <span class="stat-val">{st.value}</span>
                  <div class="stat-lbl">
                    <span class="lang-en">{st.label.en}</span>
                    <span class="lang-ru">{st.label.ru}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Right: Deep Interactive 3D System Topology & Architecture Engine -->
          <div class="brutal-box stage-iso-card">
            <div class="stage-header">
              <span>
                <span class="lang-en">3D SYSTEM ARCHITECTURE TOPOLOGY</span>
                <span class="lang-ru">3D-ТОПОЛОГИЯ АРХИТЕКТУРЫ СИСТЕМ</span>
              </span>
              <span id="iso-trace-status">8 NODES · DRAG / ⌘+SCROLL / CLICK</span>
            </div>

            <!-- Top Controls: Domain Switcher & 3D Engine Modes -->
            <div class="arch-tabs-bar">
              <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                <button
                  type="button"
                  class="mode-btn active"
                  data-iso-domain="yagni"
                  onclick="window.setIsoDomain('yagni', this)"
                  data-track="topology_interact"
                  data-track-action="domain"
                >
                  <span class="lang-en">AGENT TEAMS (YAGNI)</span>
                  <span class="lang-ru">АГЕНТЫ (YAGNI)</span>
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  data-iso-domain="voice"
                  onclick="window.setIsoDomain('voice', this)"
                  data-track="topology_interact"
                  data-track-action="domain"
                >
                  <span class="lang-en">VOICE AI (SULLY)</span>
                  <span class="lang-ru">ГОЛОСОВОЙ AI</span>
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  data-iso-domain="saas"
                  onclick="window.setIsoDomain('saas', this)"
                  data-track="topology_interact"
                  data-track-action="domain"
                >
                  <span class="lang-en">B2B SAAS & OPS</span>
                  <span class="lang-ru">B2B SAAS И OPS</span>
                </button>
              </div>

              <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                <button
                  type="button"
                  class="mode-btn mode-btn-fault"
                  id="btn-iso-fault"
                  onclick="window.triggerIsoFault()"
                  data-track="topology_interact"
                  data-track-action="fault"
                >
                  <span class="lang-en">INJECT FAULT</span><span class="lang-ru">ТЕСТ СБОЯ</span>
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  id="btn-iso-xray"
                  onclick="window.toggleIsoXray(this)"
                  data-track="topology_interact"
                  data-track-action="xray"
                >
                  <span class="lang-en">CAD X-RAY</span><span class="lang-ru">РЕНТГЕН CAD</span>
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  id="btn-iso-reset"
                  onclick="window.resetIsoCamera()"
                  data-track="topology_interact"
                  data-track-action="reset"
                >
                  <span class="lang-en">OVERVIEW</span><span class="lang-ru">ОБЗОР</span>
                </button>
                <button
                  type="button"
                  class="mode-btn active"
                  onclick="window.fireIsoPacket()"
                  data-track="topology_interact"
                  data-track-action="packet"
                >
                  <span class="lang-en">TRACE</span><span class="lang-ru">ТРАССИРОВКА</span>
                </button>
              </div>
            </div>

            <!-- Deep 3D Spatial Canvas (3 Vertical Strata + Exploded Node Inspector) -->
            <div class="iso-canvas-container" id="iso-canvas-wrap">
              <canvas
                id="iso-arch-canvas"
                tabindex="0"
                role="application"
                aria-label="Interactive 3D System Architecture Topology. Use Left and Right arrow keys to cycle nodes, Enter to explode node layers, F to simulate fault."
              ></canvas>

              <!-- Vertical Depth Deck Slicer (Top-Right) -->
              <div class="iso-stratum-rail">
                <button
                  type="button"
                  class="iso-stratum-btn active"
                  data-stratum-btn="all"
                  onclick="window.setIsoStratum('all', this)"
                  data-track="topology_interact"
                  data-track-action="stratum"
                >
                  <span class="lang-en">ALL 3 DECKS</span><span class="lang-ru">ВСЕ 3 ЯРУСА</span>
                </button>
                <button
                  type="button"
                  class="iso-stratum-btn"
                  data-stratum-btn="1"
                  onclick="window.setIsoStratum(1, this)"
                  data-track="topology_interact"
                  data-track-action="stratum"
                >
                  <span class="lang-en">L+1 · ORBITAL RADAR</span><span class="lang-ru">L+1 · РАДАР И EVALS</span>
                </button>
                <button
                  type="button"
                  class="iso-stratum-btn"
                  data-stratum-btn="0"
                  onclick="window.setIsoStratum(0, this)"
                  data-track="topology_interact"
                  data-track-action="stratum"
                >
                  <span class="lang-en">L0 · CORE DECK</span><span class="lang-ru">L0 · ЯДРО СИСТЕМЫ</span>
                </button>
                <button
                  type="button"
                  class="iso-stratum-btn"
                  data-stratum-btn="-1"
                  onclick="window.setIsoStratum(-1, this)"
                  data-track="topology_interact"
                  data-track-action="stratum"
                >
                  <span class="lang-en">L-1 · SUB-VAULT</span><span class="lang-ru">L-1 · БУНКЕР ИЗОЛЯЦИИ</span>
                </button>
              </div>

              <!-- Interactive Node Dossier Overlay (Appears when a 3D building is clicked/exploded) -->
              <div class="iso-inspector-card" id="iso-inspector-card">
                <div class="iso-insp-head">
                  <span class="iso-insp-title" id="iso-insp-title">02 · AGENT CORE</span>
                  <button type="button" class="iso-insp-close" onclick="window.resetIsoCamera()" data-track="topology_interact" data-track-action="reset">×</button>
                </div>
                <div id="iso-insp-sub" style="font-size: 0.72rem; color: #B8C0D4; margin-bottom: 6px;"></div>
                <div class="iso-insp-layers" id="iso-insp-layers"></div>
                <div class="iso-insp-guard" id="iso-insp-guard"></div>
                <div class="iso-insp-actions">
                  <button type="button" class="iso-insp-btn" onclick="window.stepIsoNode(-1)" data-track="topology_interact" data-track-action="step">
                    <span class="lang-en">‹ PREV NODE</span><span class="lang-ru">‹ ПРЕД. УЗЕЛ</span>
                  </button>
                  <button type="button" class="iso-insp-btn iso-insp-btn-fault" onclick="window.triggerIsoFault(true)" data-track="topology_interact" data-track-action="fault">
                    <span class="lang-en">BREAK & HEAL</span><span class="lang-ru">СБОЙ И ФИКС</span>
                  </button>
                  <button type="button" class="iso-insp-btn" onclick="window.stepIsoNode(1)" data-track="topology_interact" data-track-action="step">
                    <span class="lang-en">NEXT NODE ›</span><span class="lang-ru">СЛЕД. УЗЕЛ ›</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Clean Bottom Specification Bar -->
            <div class="iso-bottom-hud">
              <div class="iso-layer-spec">
                <span class="iso-spec-pill" id="iso-hud-badge">02 · AGENT CORE</span>
                <span id="iso-hud-text" style="font-weight: 700;">
                  Named AI Agent Team (PM, Builder, Reviewer, Judge) under Human Plan
                </span>
              </div>
              <button
                type="button"
                class="mode-btn"
                style="padding: 3px 9px; font-size: 0.68rem;"
                onclick="window.openDomainBlueprint()"
                data-track="topology_interact"
                data-track-action="blueprint"
              >
                <span class="lang-en">BLUEPRINT ↘</span>
                <span class="lang-ru">КЕЙС ↘</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- EXPERIENCE: one chronology. Each job carries its story, numbers, stack and architecture. -->
      <section id="experience" class="section-block">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="section-kicker">
                <span class="lang-en">Experience · 2018 — now</span>
                <span class="lang-ru">Опыт · 2018 — сейчас</span>
              </span>
              <h2 class="section-title">
                <span class="lang-en">8+ years in production</span>
                <span class="lang-ru">8+ лет в продакшене</span>
              </h2>
            </div>
          </div>

          <div class="toolbox" id="toolbox">
            <div class="toolbox-intro">
              <div>
                <span class="label">
                  <span class="lang-en">Toolbox · for skimmers and screeners</span>
                  <span class="lang-ru">Инструменты · для тех, кто сканирует</span>
                </span>
                <p class="toolbox-lead">
                  <span class="lang-en">
                    Every keyword in one place, for recruiters who skim and the ATS and LLMs that parse.
                    Click a skill to see where I used it. The same list lives in
                  </span>
                  <span class="lang-ru">
                    Все ключевые слова в одном месте: для рекрутеров, которые пробегают глазами, и для ATS и LLM, которые парсят.
                    Нажмите на навык, чтобы увидеть, где я его применял. Тот же список лежит в
                  </span>
                  <a class="text-link" href="/llms.txt" target="_blank">/llms.txt</a>.
                </p>
              </div>
              <button type="button" class="brutal-btn brutal-btn-sm" onclick="window.copyToolbox()" data-track="toolbox_copy">
                <span class="lang-en">COPY AS TEXT</span>
                <span class="lang-ru">СКОПИРОВАТЬ ТЕКСТОМ</span>
              </button>
            </div>

            {CAPABILITIES.map((cap) => (
              <div class="toolbox-row" data-toolbox-row>
                <span class="toolbox-head">
                  <span class="lang-en">{cap.title.en}</span>
                  <span class="lang-ru">{cap.title.ru}</span>
                </span>
                <span class="toolbox-skills">
                  {cap.skills.map((skill) =>
                    SKILL_USAGE[skill] ? (
                      <button
                        type="button"
                        class="skill-link"
                        data-skill={skill}
                        data-track="skill_click"
                        data-track-skill={skill}
                        data-jobs={SKILL_USAGE[skill].join(' ')}
                        aria-pressed="false"
                        aria-controls="experience-timeline"
                        onclick="window.selectSkill(this)"
                      >
                        {skill}
                      </button>
                    ) : (
                      <span class="skill-plain">{skill}</span>
                    )
                  )}
                </span>
              </div>
            ))}

            <div class="toolbox-result" id="toolbox-result" aria-live="polite" hidden></div>
          </div>

          <ol class="timeline" id="experience-timeline">
            {EXPERIENCE.map((exp, idx) => {
              const cs = CASE_STUDIES.find((c) => c.id === exp.caseId);
              const numbers = cs ? cs.metrics.filter((m) => /\d/.test(m.value)) : [];
              return (
                <li class="brutal-box job-card" id={exp.id} data-company={exp.company}>
                  <div class="job-head">
                    <div>
                      <div class="job-company">
                        {exp.url ? (
                          <a class="text-link" href={exp.url} target="_blank" rel="noopener noreferrer">
                            {exp.company} ↗
                          </a>
                        ) : (
                          <span>{exp.company}</span>
                        )}
                        {idx === 0 && (
                          <span class="label label-now">
                            <span class="lang-en">Now</span>
                            <span class="lang-ru">Сейчас</span>
                          </span>
                        )}
                      </div>
                      <h3 class="job-role">
                        <span class="lang-en">{exp.role.en}</span>
                        <span class="lang-ru">{exp.role.ru}</span>
                      </h3>
                    </div>
                    <div class="job-meta">
                      <div>
                        <span class="lang-en">{exp.period.en}</span>
                        <span class="lang-ru">{exp.period.ru}</span>
                      </div>
                      <div>
                        <span class="lang-en">{exp.location.en}</span>
                        <span class="lang-ru">{exp.location.ru}</span>
                      </div>
                    </div>
                  </div>

                  <p class="job-domain">
                    <span class="lang-en">{exp.domain.en}</span>
                    <span class="lang-ru">{exp.domain.ru}</span>
                  </p>

                  {numbers.length > 0 && (
                    <div class="job-metrics">
