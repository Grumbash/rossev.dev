---
import '../styles/brutalism.css';
import {
  PROFILE,
  CASE_STUDIES,
  EXPERIENCE,
  CAPABILITIES,
  BLOG_POSTS,
  BLOG_MOMENTUM,
} from '../data/profile';
import BlogGrid from '../components/BlogGrid.astro';
import CaseBlueprint from '../components/CaseBlueprint.astro';
---

<!DOCTYPE html>
<html lang="en" data-lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gleb Rosev — Staff Engineer @ YAGNI | AI Agent Teams, Architecture & Reliability</title>
    <meta
      name="description"
      content="Gleb Rosev — Staff Engineer at YAGNI (yagni.app) making AI agent teams dependable in production. 8+ years building distributed systems, Voice AI (Sully.ai), and leading engineering teams."
    />
    <script src="/htmx.min.js" defer></script>
  </head>
  <body>
    <!-- TOP STICKY NEO-BRUTALIST NAVBAR & SECTION DECK SWITCHER -->
    <header class="top-nav">
      <div class="nav-inner">
        <a href="#top" class="brand-logo" onclick="window.switchSectionDeck('all')">
          <span class="brand-badge">GR</span>
          <span>GLEB ROSEV</span>
          <span class="status-dot" title="Staff Engineer @ YAGNI (yagni.app)"></span>
        </a>

        <nav class="nav-links" aria-label="Section Deck Switcher">
          <button
            type="button"
            class="nav-link active-deck"
            data-deck-btn="all"
            onclick="window.switchSectionDeck('all', this)"
          >
            <span class="lang-en">ALL</span>
            <span class="lang-ru">ВСЕ</span>
          </button>
          <button
            type="button"
            class="nav-link"
            data-deck-btn="impact"
            onclick="window.switchSectionDeck('impact', this)"
          >
            <span class="lang-en">01. NOW & IMPACT</span>
            <span class="lang-ru">01. СЕЙЧАС И ИМПАКТ</span>
          </button>
          <button
            type="button"
            class="nav-link"
            data-deck-btn="systems"
            onclick="window.switchSectionDeck('systems', this)"
          >
            <span class="lang-en">02. SYSTEMS</span>
            <span class="lang-ru">02. КЕЙСЫ</span>
          </button>
          <button
            type="button"
            class="nav-link"
            data-deck-btn="experience"
            onclick="window.switchSectionDeck('experience', this)"
          >
            <span class="lang-en">03. CAREER</span>
            <span class="lang-ru">03. ОПЫТ</span>
          </button>
          <button
            type="button"
            class="nav-link"
            data-deck-btn="capabilities"
            onclick="window.switchSectionDeck('capabilities', this)"
          >
            <span class="lang-en">04. STACK</span>
            <span class="lang-ru">04. СТЕК</span>
          </button>
          <button
            type="button"
            class="nav-link"
            data-deck-btn="writing"
            onclick="window.switchSectionDeck('writing', this)"
          >
            <span class="lang-en">05. WRITING</span>
            <span class="lang-ru">05. БЛОГ</span>
          </button>
          <button
            type="button"
            class="nav-link"
            data-deck-btn="contact"
            onclick="window.switchSectionDeck('contact', this)"
          >
            <span class="lang-en">06. CONTACT</span>
            <span class="lang-ru">06. КОНТАКТЫ</span>
          </button>
        </nav>

        <div class="nav-controls">
          <button
            type="button"
            class="ctrl-btn active-lang"
            id="btn-lang-en"
            onclick="window.setSiteLang('en')"
            aria-label="Switch language to English"
          >
            EN
          </button>
          <button
            type="button"
            class="ctrl-btn"
            id="btn-lang-ru"
            onclick="window.setSiteLang('ru')"
            aria-label="Switch language to Russian"
          >
            RU
          </button>
          <button
            type="button"
            class="ctrl-btn"
            id="btn-theme-toggle"
            onclick="window.toggleSiteTheme()"
            title="Toggle Light / Dark Mode"
          >
            THEME
          </button>
        </div>
      </div>
    </header>

    <main id="top">
      <!-- HERO SECTION -->
      <section class="hero-section container" data-deck-section="hero">
        <div class="hero-grid">
          <!-- Left: Concise Hero Copy & Badges -->
          <div class="brutal-box hero-card">
            <div>
              <div class="sticker-row">
                <span class="draggable-sticker" style="background: var(--lime);" title="Drag me">
                  STAFF ENGINEER @ YAGNI.APP
                </span>
                <span class="draggable-sticker" style="background: var(--yellow);" title="Drag me">
                  8+ YRS IN PROD
                </span>
                <span class="draggable-sticker" style="background: var(--cyan);" title="Drag me">
                  AGENT TEAMS & EVALS
                </span>
                <span class="draggable-sticker" style="background: var(--orange); color: #fff;" title="Drag me">
                  TBILISI · US TEAM
                </span>
              </div>

              <h1 class="hero-title">
                <span class="lang-en">GLEB <span class="hero-title-highlight">ROSEV</span></span>
                <span class="lang-ru">ГЛЕБ <span class="hero-title-highlight">РОСЕВ</span></span>
              </h1>

              <div class="hero-role">
                <span class="lang-en">{PROFILE.tagline.en}</span>
                <span class="lang-ru">{PROFILE.tagline.ru}</span>
              </div>

              <p class="hero-bio">
                <span class="lang-en">{PROFILE.bio.en}</span>
                <span class="lang-ru">{PROFILE.bio.ru}</span>
              </p>

              <div class="med-twist-box">
                <span class="lang-en">{PROFILE.medToAiStory.en}</span>
                <span class="lang-ru">{PROFILE.medToAiStory.ru}</span>
              </div>

              <div class="hero-actions">
                <button
                  type="button"
                  class="brutal-btn brutal-btn-lime"
                  onclick="window.switchSectionDeck('systems')"
                >
                  <span class="lang-en">SYSTEMS & CASES ↘</span>
                  <span class="lang-ru">СИСТЕМЫ И КЕЙСЫ ↘</span>
                </button>
                <button
                  type="button"
                  class="brutal-btn brutal-btn-yellow"
                  onclick="window.switchSectionDeck('writing')"
                >
                  <span class="lang-en">WRITING</span>
                  <span class="lang-ru">БЛОГ</span>
                </button>
                <button
                  type="button"
                  class="brutal-btn brutal-btn-cyan"
                  onclick="window.copyToClipboard('rossevgleb@gmail.com', 'Email copied: rossevgleb@gmail.com')"
                >
                  <span>rossevgleb@gmail.com</span>
                </button>
                <button
                  type="button"
                  class="brutal-btn"
                  onclick="window.print()"
                >
                  <span class="lang-en">PDF CV</span>
                  <span class="lang-ru">CV (PDF)</span>
                </button>
              </div>
            </div>

            <!-- 4 Hero Stats -->
            <div class="hero-stats-grid">
              {PROFILE.heroStats.map((st) => (
                <div class="stat-card">
                  <span class="stat-val" style={`background: ${st.color};`}>{st.value}</span>
                  <div class="stat-lbl">
                    <span class="lang-en">{st.label.en}</span>
                    <span class="lang-ru">{st.label.ru}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Right: Deep Interactive 3D System Topology & Architecture Engine -->
          <div class="brutal-box stage-iso-card">
            <div class="stage-header">
              <span>
                <span class="lang-en">3D SYSTEM ARCHITECTURE TOPOLOGY</span>
                <span class="lang-ru">3D-ТОПОЛОГИЯ АРХИТЕКТУРЫ СИСТЕМ</span>
              </span>
              <span id="iso-trace-status">8 NODES · DRAG / SCROLL / CLICK 3D</span>
            </div>

            <!-- Top Controls: Domain Switcher & 3D Engine Modes -->
            <div class="arch-tabs-bar">
              <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                <button
                  type="button"
                  class="mode-btn active"
                  data-iso-domain="yagni"
                  onclick="window.setIsoDomain('yagni', this)"
                >
                  <span class="lang-en">AGENT TEAMS (YAGNI)</span>
                  <span class="lang-ru">АГЕНТЫ (YAGNI)</span>
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  data-iso-domain="voice"
                  onclick="window.setIsoDomain('voice', this)"
                >
                  <span class="lang-en">VOICE AI (SULLY)</span>
                  <span class="lang-ru">ГОЛОСОВОЙ AI</span>
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  data-iso-domain="saas"
                  onclick="window.setIsoDomain('saas', this)"
                >
                  <span class="lang-en">B2B SAAS & OPS</span>
                  <span class="lang-ru">B2B SAAS И OPS</span>
                </button>
              </div>

              <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                <button
                  type="button"
                  class="mode-btn mode-btn-fault"
                  id="btn-iso-fault"
                  onclick="window.triggerIsoFault()"
                >
                  <span class="lang-en">INJECT FAULT</span><span class="lang-ru">ТЕСТ СБОЯ</span>
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  id="btn-iso-xray"
                  onclick="window.toggleIsoXray(this)"
                >
                  <span class="lang-en">CAD X-RAY</span><span class="lang-ru">РЕНТГЕН CAD</span>
                </button>
                <button
                  type="button"
                  class="mode-btn"
                  id="btn-iso-reset"
                  onclick="window.resetIsoCamera()"
                >
                  <span class="lang-en">OVERVIEW</span><span class="lang-ru">ОБЗОР</span>
                </button>
                <button
                  type="button"
                  class="mode-btn active"
                  onclick="window.fireIsoPacket()"
                >
                  <span class="lang-en">TRACE</span><span class="lang-ru">ТРАССИРОВКА</span>
                </button>
              </div>
            </div>

            <!-- Deep 3D Spatial Canvas (3 Vertical Strata + Exploded Node Inspector) -->
            <div class="iso-canvas-container" id="iso-canvas-wrap">
              <canvas id="iso-arch-canvas"></canvas>

              <!-- Vertical Depth Deck Slicer (Top-Right) -->
              <div class="iso-stratum-rail">
                <button
                  type="button"
                  class="iso-stratum-btn active"
                  data-stratum-btn="all"
                  onclick="window.setIsoStratum('all', this)"
                >
                  <span class="lang-en">ALL 3 DECKS</span><span class="lang-ru">ВСЕ 3 ЯРУСА</span>
                </button>
                <button
                  type="button"
                  class="iso-stratum-btn"
                  data-stratum-btn="1"
                  onclick="window.setIsoStratum(1, this)"
                >
                  <span class="lang-en">L+1 · ORBITAL RADAR</span><span class="lang-ru">L+1 · РАДАР И EVALS</span>
                </button>
                <button
                  type="button"
                  class="iso-stratum-btn"
                  data-stratum-btn="0"
                  onclick="window.setIsoStratum(0, this)"
                >
                  <span class="lang-en">L0 · CORE DECK</span><span class="lang-ru">L0 · ЯДРО СИСТЕМЫ</span>
                </button>
                <button
                  type="button"
                  class="iso-stratum-btn"
                  data-stratum-btn="-1"
                  onclick="window.setIsoStratum(-1, this)"
                >
                  <span class="lang-en">L-1 · SUB-VAULT</span><span class="lang-ru">L-1 · БУНКЕР ИЗОЛЯЦИИ</span>
                </button>
              </div>

              <!-- Interactive Node Dossier Overlay (Appears when a 3D building is clicked/exploded) -->
              <div class="iso-inspector-card" id="iso-inspector-card">
                <div class="iso-insp-head">
                  <span class="iso-insp-title" id="iso-insp-title">02 · AGENT CORE</span>
                  <button type="button" class="iso-insp-close" onclick="window.resetIsoCamera()">×</button>
                </div>
                <div id="iso-insp-sub" style="font-size: 0.72rem; color: #B8C0D4; margin-bottom: 6px;"></div>
                <div class="iso-insp-layers" id="iso-insp-layers"></div>
                <div class="iso-insp-guard" id="iso-insp-guard"></div>
                <div class="iso-insp-actions">
                  <button type="button" class="iso-insp-btn" onclick="window.stepIsoNode(-1)">
                    <span class="lang-en">‹ PREV NODE</span><span class="lang-ru">‹ ПРЕД. УЗЕЛ</span>
                  </button>
                  <button type="button" class="iso-insp-btn iso-insp-btn-fault" onclick="window.triggerIsoFault(true)">
                    <span class="lang-en">BREAK & HEAL</span><span class="lang-ru">СБОЙ И ФИКС</span>
                  </button>
                  <button type="button" class="iso-insp-btn" onclick="window.stepIsoNode(1)">
                    <span class="lang-en">NEXT NODE ›</span><span class="lang-ru">СЛЕД. УЗЕЛ ›</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Clean Bottom Specification Bar -->
            <div class="iso-bottom-hud">
              <div class="iso-layer-spec">
                <span class="iso-spec-pill" id="iso-hud-badge">02 · AGENT CORE</span>
                <span id="iso-hud-text" style="font-weight: 700;">
                  Named AI Agent Team (PM, Builder, Reviewer, Judge) under Human Plan
                </span>
              </div>
              <button
                type="button"
                class="mode-btn"
                style="padding: 3px 9px; font-size: 0.68rem;"
                onclick="window.openDomainBlueprint()"
              >
                <span class="lang-en">BLUEPRINT ↘</span>
                <span class="lang-ru">КЕЙС ↘</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- KINETIC MARQUEE TICKER -->
      <div class="marquee-bar" aria-hidden="true">
        <div class="marquee-track">
          <span>
            // STAFF ENGINEER @ YAGNI (YAGNI.APP) // AGENT TEAMS MANAGED LIKE YOUR ENGINEERING TEAM // PROPOSAL TO MERGED GITHUB PR // REALISTIC AGENT BENCHMARKS & SELF-IMPROVING LOOPS // RISK RADAR & SANDBOXED RUNNERS // EX-STAFF AI @ SULLY.AI (400+ HEALTHCARE ORGS) // HANDS-ON LEADERSHIP (5–12 ENGINEERS) //
          </span>
          <span>
            // STAFF ENGINEER @ YAGNI (YAGNI.APP) // AGENT TEAMS MANAGED LIKE YOUR ENGINEERING TEAM // PROPOSAL TO MERGED GITHUB PR // REALISTIC AGENT BENCHMARKS & SELF-IMPROVING LOOPS // RISK RADAR & SANDBOXED RUNNERS // EX-STAFF AI @ SULLY.AI (400+ HEALTHCARE ORGS) // HANDS-ON LEADERSHIP (5–12 ENGINEERS) //
          </span>
        </div>
      </div>

      <!-- 01. EXECUTIVE IMPACT & INTERACTIVE DOSSIER -->
      <section id="impact" class="section-block" data-deck-section="impact">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="section-kicker">
                <span class="lang-en">01 // NOW & EXECUTIVE IMPACT</span>
                <span class="lang-ru">01 // ТЕКУЩАЯ РОЛЬ И ИМПАКТ</span>
              </span>
              <h2 class="section-title">
                <span class="lang-en">DEPENDABLE AI AGENTS & PRODUCTION LEADERSHIP</span>
                <span class="lang-ru">НАДЁЖНЫЕ AI-АГЕНТЫ И ЛИДЕРСТВО В ПРОДАКШЕНЕ</span>
              </h2>
            </div>
          </div>

          <div class="impact-terminal-grid">
            <div class="impact-cards-grid">
              {PROFILE.selectedImpact.map((item) => (
                <div class="brutal-box brutal-box-hover impact-card" data-tilt>
                  <div>
                    <span class="impact-code" style={`background: ${item.color};`}>
                      <span class="lang-en">{item.tag.en}</span>
                      <span class="lang-ru">{item.tag.ru}</span>
                    </span>
                    <h3>
                      <span class="lang-en">{item.title.en}</span>
                      <span class="lang-ru">{item.title.ru}</span>
                    </h3>
                    <p style="font-size: 0.9rem; color: var(--ink-muted);">
                      <span class="lang-en">{item.text.en}</span>
                      <span class="lang-ru">{item.text.ru}</span>
                    </p>
                  </div>
                </div>
              ))}
            </div>

            <!-- Interactive Dossier -->
            <div class="brutal-box htmx-terminal">
              <div class="terminal-topbar">
                <span>
                  <span class="lang-en">ENGINEERING DOSSIER</span>
                  <span class="lang-ru">ИНЖЕНЕРНОЕ ДОСЬЕ</span>
                </span>
                <span>GLEB ROSEV</span>
              </div>

              <div class="terminal-cmd-bar" role="group" aria-label="Profile Focus Areas">
                <button
                  type="button"
                  class="cmd-btn active"
                  hx-get="/partials/terminal-status"
                  hx-target="#htmx-terminal-output"
                  hx-swap="innerHTML transition:true"
                  onclick="window.activateGroupBtn(this)"
                >
                  <span class="lang-en">Now @ YAGNI</span>
                  <span class="lang-ru">Сейчас в YAGNI</span>
                </button>
                <button
                  type="button"
                  class="cmd-btn"
                  hx-get="/partials/terminal-ai-harness"
                  hx-target="#htmx-terminal-output"
                  hx-swap="innerHTML transition:true"
                  onclick="window.activateGroupBtn(this)"
                >
                  <span class="lang-en">Agents & Voice AI</span>
                  <span class="lang-ru">Агенты и Voice AI</span>
                </button>
                <button
                  type="button"
                  class="cmd-btn"
                  hx-get="/partials/terminal-leadership"
                  hx-target="#htmx-terminal-output"
                  hx-swap="innerHTML transition:true"
                  onclick="window.activateGroupBtn(this)"
                >
                  <span class="lang-en">Leadership</span>
                  <span class="lang-ru">Лидерство</span>
                </button>
                <button
                  type="button"
                  class="cmd-btn"
                  hx-get="/partials/terminal-med-to-ai"
                  hx-target="#htmx-terminal-output"
                  hx-swap="innerHTML transition:true"
                  onclick="window.activateGroupBtn(this)"
                >
                  <span class="lang-en">How I Work</span>
                  <span class="lang-ru">Подход к работе</span>
                </button>
              </div>

              <div id="htmx-terminal-output" class="terminal-screen" aria-live="polite">
                <div style="color: #C8FF00; font-weight: 800; margin-bottom: 10px;">
                  <span class="lang-en">// CURRENT FOCUS // NOW</span>
                  <span class="lang-ru">// ТЕКУЩИЙ ФОКУС // СЕЙЧАС</span>
                </div>
                <div class="lang-en">
                  <p>▸ <strong>ROLE:</strong> Staff Engineer @ <strong>YAGNI (yagni.app)</strong> · Core Team (Oct 2026 — Present)</p>
                  <p>▸ <strong>MISSION:</strong> Making AI agent teams dependable in production, not just impressive in a demo.</p>
                  <p>▸ <strong>WORKFLOW:</strong> Named agents (Builder, Reviewer, PM) taking work from proposal to merged GitHub PR under human-approved plans.</p>
                  <p>▸ <strong>TRACK RECORD:</strong> 8+ Years across AI Systems (Sully.ai), Multi-Tenant B2B SaaS (Kingpin) & Distributed Architectures.</p>
                </div>
                <div class="lang-ru">
                  <p>▸ <strong>РОЛЬ:</strong> Staff Engineer в <strong>YAGNI (yagni.app)</strong> · Основная команда (Окт 2026 — наст. время)</p>
                  <p>▸ <strong>ФОКУС:</strong> Делаю команды AI-агентов надёжными в продакшене, а не только эффектными на демо.</p>
                  <p>▸ <strong>ПРОЦЕСС:</strong> Именованные агенты (Builder, Reviewer, PM) доводят задачи от идеи до смерженного PR в GitHub по утверждённому человеком плану.</p>
                  <p>▸ <strong>ОПЫТ:</strong> 8+ лет в архитектуре, голосовом AI (Sully.ai), B2B SaaS (Kingpin) и управлении командами.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 02. PRODUCTION SYSTEMS & CASE STUDIES -->
      <section id="systems" class="section-block" data-deck-section="systems">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="section-kicker" style="background: var(--lime);">
                <span class="lang-en">02 // PRODUCTION SYSTEMS</span>
                <span class="lang-ru">02 // ПРОДАКШЕН-СИСТЕМЫ</span>
              </span>
              <h2 class="section-title">
                <span class="lang-en">SELECTED ARCHITECTURE CASE STUDIES</span>
                <span class="lang-ru">КЛЮЧЕВЫЕ ИНЖЕНЕРНЫЕ КЕЙСЫ</span>
              </h2>
            </div>
          </div>

          <div class="cases-grid">
            {CASE_STUDIES.map((cs) => (
              <article class="brutal-box brutal-box-hover case-card" data-tilt>
                <div>
                  <div class="case-meta-top">
                    <span class="case-badge" style={`background: ${cs.color};`}>
                      <span class="lang-en">{cs.badge.en}</span>
                      <span class="lang-ru">{cs.badge.ru}</span>
                    </span>
                    <span class="case-period">{cs.company} · {cs.period}</span>
                  </div>

                  <h3 class="case-title">
                    <span class="lang-en">{cs.title.en}</span>
                    <span class="lang-ru">{cs.title.ru}</span>
                  </h3>

                  <p class="case-summary">
                    <span class="lang-en">{cs.summary.en}</span>
                    <span class="lang-ru">{cs.summary.ru}</span>
                  </p>

                  <div class="case-metrics-row">
                    {cs.metrics.map((m) => (
                      <div class="case-metric-box">
                        <span class="case-metric-val">{m.value}</span>
                        <span class="case-metric-lbl">
                          <span class="lang-en">{m.label.en}</span>
                          <span class="lang-ru">{m.label.ru}</span>
                        </span>
                      </div>
                    ))}
                  </div>

                  <div class="stack-pills">
                    {cs.stack.map((tech) => (
                      <span class="brutal-tag">{tech}</span>
                    ))}
                  </div>
                </div>

                <button
                  type="button"
                  class="brutal-btn"
                  style={`background: ${cs.color}; color: #0A0A0A; width: 100%; justify-content: space-between;`}
                  hx-get={`/partials/case-${cs.id}`}
                  hx-target="#arch-blueprint-slot"
                  hx-swap="innerHTML transition:true"
                  onclick="document.getElementById('arch-blueprint-slot')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' })"
                >
                  <span>
                    <span class="lang-en">VIEW ARCHITECTURE</span>
                    <span class="lang-ru">СХЕМА АРХИТЕКТУРЫ</span>
                  </span>
                  <span>↓</span>
                </button>
              </article>
            ))}
          </div>

          <div id="arch-blueprint-slot" aria-live="polite">
            <CaseBlueprint study={CASE_STUDIES[0]} />
          </div>
        </div>
      </section>

      <!-- 03. CONCISE INTERACTIVE CAREER DECK -->
      <section id="experience" class="section-block" data-deck-section="experience">
        <div class="container">
          <div class="section-head">
            <div>
              <span class="section-kicker" style="background: var(--cyan);">
                <span class="lang-en">03 // CAREER TRACK RECORD</span>
                <span class="lang-ru">03 // КАРЬЕРНЫЙ ТРЕК</span>
              </span>
