        // Mouse & Touch Orbit + Node Picking + Scroll Zoom
        canvas.addEventListener('pointerdown', (e) => {
          isDragging = true;
          dragMoved = false;
          dragStartX = e.clientX;
          dragStartY = e.clientY;
          canvas.setPointerCapture(e.pointerId);
        });

        canvas.addEventListener('pointermove', (e) => {
          const rect = canvas.getBoundingClientRect();
          const mx = e.clientX - rect.left;
          const my = e.clientY - rect.top;

          if (isDragging) {
            const dx = e.clientX - dragStartX;
            const dy = e.clientY - dragStartY;
            if (Math.hypot(dx, dy) > 4) dragMoved = true;
            targetYaw += dx * 0.0065;
            targetPitch = Math.max(0.28, Math.min(0.86, targetPitch + dy * 0.0045));
            dragStartX = e.clientX;
            dragStartY = e.clientY;
            return;
          }

          let bestIdx = -1;
          let bestDepth = Infinity;
          for (let i = 0; i < nodeScreenCache.length; i++) {
            const sc = nodeScreenCache[i];
            if (!sc) continue;
            if (
              mx >= sc.minX - 10 &&
              mx <= sc.maxX + 10 &&
              my >= sc.minY - 26 &&
              my <= sc.maxY + 8
            ) {
              if (sc.depth < bestDepth) {
                bestDepth = sc.depth;
                bestIdx = i;
              }
            }
          }

          if (bestIdx !== hoveredNode) {
            hoveredNode = bestIdx;
            canvas.style.cursor = bestIdx >= 0 ? 'pointer' : 'grab';
            window.updateIsoHudText();
          }
        });

        canvas.addEventListener('pointerup', () => {
          if (!dragMoved) {
            if (hoveredNode >= 0) {
