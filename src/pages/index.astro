    <script is:inline>
      // 1. Language & Theme Switcher
      window.setSiteLang = function (lang) {
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang);
        localStorage.setItem('rosev_lang', lang);
        const btnEn = document.getElementById('btn-lang-en');
        const btnRu = document.getElementById('btn-lang-ru');
        if (btnEn && btnRu) {
          btnEn.classList.toggle('active-lang', lang === 'en');
          btnRu.classList.toggle('active-lang', lang === 'ru');
        }
        if (window.updateIsoHudText) {
          window.updateIsoHudText();
        }
      };

      window.toggleSiteTheme = function () {
        const cur = document.documentElement.getAttribute('data-theme') || 'light';
        const next = cur === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('rosev_theme', next);
      };

      (function syncLangButtons() {
        const savedLang = document.documentElement.getAttribute('data-lang') || 'en';
        const btnEn = document.getElementById('btn-lang-en');
        const btnRu = document.getElementById('btn-lang-ru');
        if (btnEn && btnRu) {
          btnEn.classList.toggle('active-lang', savedLang === 'en');
          btnRu.classList.toggle('active-lang', savedLang === 'ru');
        }
      })();

      // 2. Spatial Section Deck Switcher with URL Deep-Linking
      window.switchSectionDeck = function (targetSection, clickedBtn, updateUrl = true) {
        document.querySelectorAll('[data-deck-btn]').forEach((b) => {
          b.classList.toggle('active-deck', b.getAttribute('data-deck-btn') === targetSection);
        });
        const sections = document.querySelectorAll('.section-block[data-deck-section]');
        sections.forEach((sec) => {
          const secKey = sec.getAttribute('data-deck-section');
          if (targetSection === 'all' || secKey === targetSection) {
            sec.classList.remove('deck-hidden');
          } else {
            sec.classList.add('deck-hidden');
          }
        });
        if (updateUrl) {
          try {
            const url = new URL(window.location.href);
            url.hash = targetSection === 'all' ? '' : targetSection;
            window.history.replaceState({}, '', url.toString());
          } catch (e) {}
        }
        if (targetSection !== 'all') {
          const targetEl = document.getElementById(targetSection);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      };

      // 3. Interactive Experience Career Deck Switcher with ARIA & URL Deep-Linking
      window.selectExperienceTab = function (expId, btn, updateUrl = true) {
        document.querySelectorAll('[data-exp-btn]').forEach((b) => {
          const isMatch = b.getAttribute('data-exp-btn') === expId;
          b.classList.toggle('active-exp', isMatch);
          b.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        });
        document.querySelectorAll('.exp-spotlight-panel').forEach((p) => {
          p.classList.toggle('active-exp-panel', p.id === 'panel-' + expId);
        });
        if (updateUrl) {
          try {
            const url = new URL(window.location.href);
            url.searchParams.set('exp', expId);
            window.history.replaceState({}, '', url.toString());
          } catch (e) {}
        }
      };

      // Restore Section Hash & Experience Tab from URL on Load
      document.addEventListener('DOMContentLoaded', () => {
        try {
          const hash = window.location.hash.replace('#', '');
          const validDecks = ['impact', 'systems', 'experience', 'capabilities', 'writing', 'contact'];
          if (validDecks.includes(hash)) {
            window.switchSectionDeck(hash, null, false);
          }
          const params = new URLSearchParams(window.location.search);
          const expParam = params.get('exp');
          if (expParam && document.getElementById('panel-' + expParam)) {
            window.selectExperienceTab(expParam, null, false);
          }
        } catch (e) {}
      });

      // 4. Clipboard & Button Helpers
      window.copyToClipboard = function (text, msg) {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(text);
        }
        const toast = document.getElementById('brutal-toast');
        if (toast) {
          toast.textContent = msg;
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2400);
        }
      };

      window.activateGroupBtn = function (btn) {
        const parent = btn.parentElement;
        if (!parent) return;
        parent.querySelectorAll('.cmd-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
      };

      window.activateFilterBtn = function (btn) {
        const parent = btn.parentElement;
        if (!parent) return;
        parent.querySelectorAll('.brutal-btn').forEach((b) => {
          b.classList.remove('active', 'brutal-btn-lime');
        });
        btn.classList.add('active', 'brutal-btn-lime');
      };

      // 5. 3D Perspective Tilt Effect on Neo-Brutalist Cards
      function initTiltCards() {
        const cards = document.querySelectorAll('[data-tilt]');
        cards.forEach((card) => {
          if (card.dataset.tiltBound) return;
          card.dataset.tiltBound = 'true';
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            const xc = rect.width / 2;
            const yc = rect.height / 2;
            const dx = (x - xc) / xc;
            const dy = (y - yc) / yc;
            card.style.transform = `perspective(900px) rotateX(${(-dy * 3.5).toFixed(2)}deg) rotateY(${(dx * 3.5).toFixed(2)}deg) translate(-2px, -2px)`;
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = '';
          });
        });
      }

      document.addEventListener('DOMContentLoaded', initTiltCards);
      document.body.addEventListener('htmx:afterSwap', initTiltCards);

      // 6. Draggable Neo-Brutalist Stickers
      document.addEventListener('DOMContentLoaded', () => {
        const stickers = document.querySelectorAll('.draggable-sticker');
        stickers.forEach((sticker) => {
          let isDragging = false;
          let startX = 0, startY = 0;
          let offsetX = 0, offsetY = 0;

          sticker.addEventListener('pointerdown', (e) => {
            isDragging = true;
            startX = e.clientX - offsetX;
            startY = e.clientY - offsetY;
            sticker.setPointerCapture(e.pointerId);
            sticker.style.zIndex = '50';
          });

          sticker.addEventListener('pointermove', (e) => {
            if (!isDragging) return;
            offsetX = e.clientX - startX;
            offsetY = e.clientY - startY;
            sticker.style.transform = `translate(${offsetX}px, ${offsetY}px) rotate(-3deg)`;
          });

          sticker.addEventListener('pointerup', () => {
            isDragging = false;
          });
        });
      });
    </script>

    <!-- Bundled TypeScript 3D Multi-Stratum Topology Engine -->
    <script>
      import { initIsoArchitectureEngine } from '../scripts/iso-engine';
      document.addEventListener('DOMContentLoaded', initIsoArchitectureEngine);
    </script>
  </body>
</html>
