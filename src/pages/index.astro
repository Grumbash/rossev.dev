                      <CaseBlueprint study={cs} showOutcomes={false} />
                    </details>
                  )}
                </li>
              );
            })}
          </ol>

        </div>
      </section>

      <!-- BEYOND THE CV: essays live in their own visual zone -->
      <div class="zone-beyond">
        <div class="container">
          <div class="zone-divider">
            <span class="lang-en">Beyond the CV</span>
            <span class="lang-ru">Вне резюме</span>
          </div>
        </div>

        {/* GR monogram: a neural cellular automaton. The static SVG (scripts/nca/train.py
            --fallback-svg) holds its place until src/scripts/nca/loader.ts lazy-loads the
            model, which never happens on Save-Data/2G; the canvas replaces it on the first frame. */}
        <section class="nca-section" aria-labelledby="nca-heading">
          <div class="container">
            <h2 id="nca-heading" class="visually-hidden">
              <span class="lang-en">Self-healing GR monogram</span>
              <span class="lang-ru">Самовосстанавливающаяся монограмма GR</span>
            </h2>
            <div class="nca-block">
              <canvas
                id="nca-canvas"
                class="nca-canvas"
                width="56"
                height="56"
                tabindex="0"
                role="button"
                aria-labelledby="nca-label"
                aria-describedby="nca-caption"
                hidden
              ></canvas>
              <svg class="nca-canvas nca-fallback" viewBox="0 0 112 112" width="56" height="56" aria-hidden="true"><rect x="56" y="24" width="46" height="64" fill="#C8FF00"/><path fill="#0A0A0A" d="M28 82Q23 82 19 80Q15 77 12 73Q10 68 10 62V50Q10 40 15 35Q21 30 30 30Q39 30 44 35Q49 40 49 48V48H40V48Q40 45 39 43Q38 41 36 40Q34 38 30 38Q25 38 22 42Q19 45 19 50V62Q19 67 22 71Q25 74 30 74Q35 74 38 71Q40 68 40 64V63H28V55H49V81H41V76H39Q39 77 38 79Q37 80 34 81Q32 82 28 82ZM60 81V31H82Q86 31 90 33Q93 34 95 37Q97 40 97 44V45Q97 50 95 52Q93 55 90 57V58Q93 58 94 60Q96 62 96 65V81H86V66Q86 64 86 63Q85 62 83 62H69V81ZM69 54H81Q84 54 86 52Q88 50 88 47V46Q88 43 86 41Q84 40 81 40H69Z"/></svg>
              <span id="nca-label" class="visually-hidden">
                <span class="lang-en">GR monogram grown by a neural cellular automaton.<span data-nca-live> Press Enter or Space to take a bite out of it and watch it heal.</span></span>
                <span class="lang-ru">Монограмма GR, выращенная нейронным клеточным автоматом.<span data-nca-live> Нажмите Enter или пробел, чтобы откусить кусок, и посмотрите, как она заживёт.</span></span>
              </span>
              <div>
                <p id="nca-caption">
                  <span class="lang-en">An 8,320-parameter neural cellular automaton, trained from scratch, running in your browser. Every pixel runs the same tiny network and only sees its neighbours. <span data-nca-live>Damage it: drag across the letters (or Tab + Enter).</span><span data-nca-paused hidden>Paused to save your data: on a faster connection this monogram grows and heals itself.</span></span>
                  <span class="lang-ru">Нейронный клеточный автомат на 8 320 параметров, обученный с нуля и работающий прямо в браузере. Каждый пиксель запускает одну и ту же крошечную сеть и видит только соседей. <span data-nca-live>Повредите его: проведите по буквам (или Tab + Enter).</span><span data-nca-paused hidden>На паузе, чтобы сэкономить трафик: на быстром соединении эта монограмма сама растёт и залечивается.</span></span>
                </p>
                <p class="nca-bridge">
                  <span class="lang-en">Same idea I apply to production: <a class="text-link" href="/?case=yagni#case-yagni" data-track="nca_interact" data-track-action="case">systems that notice damage and repair themselves →</a></span>
                  <span class="lang-ru">Тот же принцип я применяю в продакшене: <a class="text-link" href="/?case=yagni#case-yagni" data-track="nca_interact" data-track-action="case">системы, которые замечают поломку и чинят себя сами →</a></span>
                </p>
                <p class="fine-print">
                  <span class="lang-en">How it works: each cell holds 16 numbers, reads its 3×3 neighbourhood through Sobel filters and updates through one 128-unit hidden layer. Trained to grow from a single cell and to heal after cuts and bites, after <a class="text-link" href="https://distill.pub/2020/growing-ca/" target="_blank" rel="noopener noreferrer">Mordvintsev et al., Distill 2020 ↗</a></span>
                  <span class="lang-ru">Как это работает: в каждой клетке 16 чисел; она смотрит на соседей 3×3 через фильтры Собеля и обновляется через один скрытый слой на 128 нейронов. Обучен вырастать из одной клетки и залечивать порезы и укусы, по статье <a class="text-link" href="https://distill.pub/2020/growing-ca/" target="_blank" rel="noopener noreferrer">Mordvintsev et al., Distill 2020 ↗</a></span>
                </p>
                <button
                  type="button"
                  id="nca-reset"
                  class="brutal-btn brutal-btn-sm"
                  data-track="nca_interact"
                  data-track-action="reset"
                  data-nca-live
                >
                  <span class="lang-en">Reset</span>
                  <span class="lang-ru">Заново</span>
                </button>
              </div>
            </div>
          </div>
        </section>

        <section id="writing" class="section-block">
          <div class="container">
            <div class="section-head">
              <div>
                <span class="section-kicker">
                  <span class="lang-en">Writing</span>
                  <span class="lang-ru">Блог</span>
                </span>
                <h2 class="section-title">
                  <span class="lang-en">Field notes on AI, systems & leadership</span>
                  <span class="lang-ru">Заметки об AI, системах и менеджменте</span>
                </h2>
              </div>
              <a
                href={PROFILE.linkedin}
                data-track="linkedin_click"
                data-track-placement="writing"
                target="_blank"
                rel="noopener noreferrer"
                class="brutal-btn"
              >
                <span class="lang-en">FOLLOW ON LINKEDIN ↗</span>
                <span class="lang-ru">ЧИТАТЬ В LINKEDIN ↗</span>
              </a>
            </div>

            <div class="filter-bar" role="group" aria-label="Filter Essays by Topic">
              <button
                type="button"
                class="filter-tab active"
                aria-pressed="true"
                hx-get="/partials/posts-all"
                data-track="post_filter"
                data-track-filter="all"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                onclick="window.activateFilterBtn(this)"
              >
                <span class="lang-en">All</span>
                <span class="lang-ru">Все</span>
              </button>
              <button
                type="button"
                class="filter-tab"
                aria-pressed="false"
                hx-get="/partials/posts-ai"
                data-track="post_filter"
                data-track-filter="ai"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                onclick="window.activateFilterBtn(this)"
              >
                <span class="lang-en">AI systems</span>
                <span class="lang-ru">AI-системы</span>
              </button>
              <button
                type="button"
                class="filter-tab"
                aria-pressed="false"
                hx-get="/partials/posts-leadership"
                data-track="post_filter"
                data-track-filter="leadership"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                onclick="window.activateFilterBtn(this)"
              >
                <span class="lang-en">Leadership</span>
                <span class="lang-ru">Лидерство</span>
              </button>
              <button
                type="button"
                class="filter-tab"
                aria-pressed="false"
                hx-get="/partials/posts-systems"
                data-track="post_filter"
                data-track-filter="systems"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                onclick="window.activateFilterBtn(this)"
              >
                <span class="lang-en">Reliability</span>
                <span class="lang-ru">Надёжность</span>
              </button>
              <button
                type="button"
                class="filter-tab"
                aria-pressed="false"
                hx-get="/partials/posts-delivery"
                data-track="post_filter"
                data-track-filter="delivery"
                hx-target="#blog-posts-container"
                hx-swap="innerHTML transition:true"
                onclick="window.activateFilterBtn(this)"
              >
                <span class="lang-en">Delivery</span>
                <span class="lang-ru">Поставка</span>
              </button>
            </div>

            <!-- HTMX On-Site Post Reader Slot -->
            <div id="post-reader-slot" aria-live="polite"></div>

            <div id="blog-posts-container" aria-live="polite">
              <BlogGrid posts={BLOG_POSTS} />
            </div>
          </div>
        </section>
      </div>

  <Fragment slot="scripts">
    <script is:inline>
      // 1. Open a job's architecture breakdown, e.g. from ?case=sully or the topology.
      window.openCaseBreakdown = function (caseId) {
        const details = document.getElementById('case-' + caseId);
        if (!details) return;
        details.open = true;
        setTimeout(() => details.scrollIntoView({ behavior: 'smooth', block: 'start' }), 120);
      };
      // Restore case study & blog brief from URL on load
      document.addEventListener('DOMContentLoaded', () => {
        try {
          const params = new URLSearchParams(window.location.search);
          const caseParam = params.get('case');
          if (caseParam && /^[a-z]+$/.test(caseParam)) {
            window.openCaseBreakdown(caseParam);
          }
          const postParam = params.get('post');
          if (postParam && /^post-\d+$/.test(postParam)) {
            fetch(`/partials/post-${postParam}`)
              .then((r) => (r.ok ? r.text() : ''))
              .then((html) => {
                const slot = document.getElementById('post-reader-slot');
                if (!slot || !html) return;
                slot.innerHTML = html;
                // Not an htmx swap, so wire up the reader's hx-* links (its "Next") by hand.
                window.htmx && window.htmx.process(slot);
              });
          }
        } catch (e) {}

        document.querySelectorAll('.job-case').forEach((d) => {
          d.addEventListener('toggle', () => {
            const caseId = d.id.replace('case-', '');
            if (d.open) {
              window.setUrlParam('case', caseId);
            } else if (new URLSearchParams(window.location.search).get('case') === caseId) {
              window.setUrlParam('case', null);
            }
          });
        });
      });

      // 2. Post cards and the reader's "Next" are real links to /writing/<slug>/. An unmodified left
      // click opens the brief inline instead; ctrl/cmd/shift/alt-click and middle-click keep the
      // browser default (the page, usually in a new tab). htmx would cancel the default of every
      // click it handles, so those links listen for open-brief, fired only from here.
      window.openBrief = function (link, e) {
        if (!window.htmx || e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        window.htmx.trigger(link, 'open-brief');
        window.setUrlParam && window.setUrlParam('post', link.getAttribute('data-track-id'));
        setTimeout(() => document.getElementById('post-reader-slot')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 120);
      };
      // Every htmx swap into the reader slot comes from openBrief (a card or the reader's "Next",
      // which the swap just removed), so hand keyboard focus to the new brief's heading. The
      // ?post= restore on load uses fetch, not htmx, and never moves focus.
      document.addEventListener('htmx:afterSwap', (e) => {
        if (e.detail?.target?.id !== 'post-reader-slot') return;
        e.detail.target.querySelector('.post-reader-heading')?.focus({ preventScroll: true });
      });

      // 3. Button Helpers
      window.activateFilterBtn = function (btn) {
        const parent = btn.parentElement;
        if (!parent) return;
        parent.querySelectorAll('.filter-tab').forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
      };
      // 4. Toolbox: copy as plain text, and click a skill to light up the jobs that used it
      window.copyToolbox = function () {
        const lines = ['Gleb Rosev — toolbox (' + location.origin + ')'];
        document.querySelectorAll('[data-toolbox-row]').forEach((row) => {
          const head = row.querySelector('.toolbox-head .lang-en')?.textContent.trim();
          const skills = [...row.querySelectorAll('.toolbox-skills > *')].map((el) => el.textContent.trim());
          lines.push(head + ': ' + skills.join(', '));
        });
        window.copyToClipboard(lines.join('\n'), 'toolbox');
      };

      window.clearSkill = function () {
        document.querySelectorAll('.skill-link').forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        document.querySelectorAll('.job-card').forEach((c) => c.classList.remove('job-dim', 'job-match'));
        const result = document.getElementById('toolbox-result');
        if (result) {
          result.hidden = true;
          result.innerHTML = '';
        }
      };

      window.selectSkill = function (btn) {
        const wasActive = btn.classList.contains('active');
        window.clearSkill();
        if (wasActive) return;
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        const jobs = (btn.getAttribute('data-jobs') || '').split(' ');
        const links = [];
        document.querySelectorAll('.job-card').forEach((card) => {
          const match = jobs.includes(card.id);
          card.classList.toggle('job-match', match);
          card.classList.toggle('job-dim', !match);
          if (match) {
            const a = document.createElement('a');
            a.className = 'text-link';
            a.href = '#' + card.id;
            a.textContent = card.getAttribute('data-company') + ' ↓';
            links.push(a);
          }
        });
        const result = document.getElementById('toolbox-result');
        if (!result) return;
        result.innerHTML =
          '<strong></strong> <span class="lang-en">— used at</span><span class="lang-ru">— где применял:</span> ';
        result.querySelector('strong').textContent = btn.getAttribute('data-skill');
        links.forEach((a) => result.append(a, ' '));
        const clear = document.createElement('button');
        clear.type = 'button';
        clear.className = 'copy-btn';
        clear.innerHTML = '<span class="lang-en">clear ×</span><span class="lang-ru">сбросить ×</span>';
        clear.onclick = window.clearSkill;
        result.append(clear);
        result.hidden = false;
      };
    </script>

    <!-- Bundled TypeScript 3D Multi-Stratum Topology Engine -->
    <script>
      import { initIsoArchitectureEngine } from '../scripts/iso-engine';
      import { initTopologyStory } from '../scripts/topology-story-dom';
      document.addEventListener('DOMContentLoaded', () => {
        initIsoArchitectureEngine();
        initTopologyStory();
      });
    </script>
    {/* GR monogram: a tiny loader; the model, worker and their CSS load near the block */}
    <script>
      import { initNcaLoader } from '../scripts/nca/loader';
      initNcaLoader();
    </script>
  </Fragment>
</Base>
