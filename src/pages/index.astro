        function isNodeConnected(a, b) {
          if (a === b) return true;
          const edges = ISO_DOMAINS[currentDomain].edges;
          for (let i = 0; i < edges.length; i++) {
            const [u, v] = edges[i];
            if ((u === a && v === b) || (u === b && v === a)) return true;
