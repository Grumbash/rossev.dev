---
// The receipts for "agents wrote the code, I did the planning": every merged PR of this site with its
// red test, what was caught before merge, what I decided, and links to the real commits. A review or
// judge is shown only where the PR itself says one ran (`review`), never implied. Renders
// src/data/build-story.json (made by `bun run build-story`); every number here is computed from it.
import Base from '../layouts/Base.astro';
import story from '../data/build-story.json';
import { computeStats, type Entry } from '../../scripts/build-story';
import { calUrl } from '../scripts/analytics';

const SITE = 'https://rossev.dev/';
const PERSON_ID = `${SITE}#person`;
const url = new URL('/how-its-built/', Astro.site || SITE).toString();
const ogImageUrl = new URL('/og-card.png', Astro.site || SITE).toString();

const prs = story.prs as Entry[];
const stats = computeStats(prs);
const lastMerged = prs.reduce((d, p) => (p.mergedAt > d ? p.mergedAt : d), '');
// The page's own first publish date; dateModified follows the data.
const PUBLISHED = '2026-11-04';
const day = (iso: string) => iso.slice(0, 10);
const short = (sha: string) => sha.slice(0, 7);

const title = 'How this site was built — Gleb Rosev';
const description =
  'Every merged PR of rossev.dev with its receipts: the test committed red first (all but the first PR), what was caught before merge, what Gleb decided, and links to the commits.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${url}#article`,
      headline: 'How this site was built',
      alternativeHeadline: 'Как собран этот сайт',
      description,
      url,
      mainEntityOfPage: { '@id': url },
      datePublished: PUBLISHED,
      dateModified: lastMerged,
      author: { '@id': PERSON_ID },
      publisher: { '@id': PERSON_ID },
      isPartOf: { '@id': `${SITE}#website` },
      inLanguage: ['en', 'ru'],
      image: ogImageUrl
    },
    // The full Person node lives on home; this is enough to resolve the @id here.
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Gleb Rosev',
      url: SITE,
      sameAs: ['https://www.linkedin.com/in/rossev/', 'https://github.com/Grumbash']
    }
  ]
};

const LOOP = [
  { en: 'Framing', ru: 'Постановка', noteEn: 'the job to be done, with me', noteRu: 'какую работу делаем — со мной', human: true },
  { en: 'Red test', ru: 'Красный тест', noteEn: 'committed first, failing', noteRu: 'первым коммитом, падает', human: false },
  { en: 'Writer agent', ru: 'Агент пишет', noteEn: 'an independent agent makes it pass', noteRu: 'отдельный агент делает его зелёным', human: false },
  { en: 'Judge', ru: 'Судья', noteEn: 'independent LLM passes on the diff', noteRu: 'независимые LLM-проверки диффа', human: false },
  { en: 'Fix', ru: 'Фикс', noteEn: 'then browser and perf checks', noteRu: 'потом браузер и perf', human: false },
  { en: 'Merge', ru: 'Мерж', noteEn: 'by me, the human', noteRu: 'делаю я, человек', human: true }
];
---

<Base title={title} description={description} canonical={url} ogType="article" jsonLd={jsonLd} cta={false}>
  <section class="section-block">
    <div class="container bs-wrap">
      <a class="text-link bs-back" href="/">
        <span class="lang-en">← Home</span>
        <span class="lang-ru">← На главную</span>
      </a>

      <span class="section-kicker">
        <span class="lang-en">Receipts</span>
        <span class="lang-ru">Доказательства</span>
      </span>
      <h1 class="section-title">
        <span class="lang-en">How this site was built</span>
        <span class="lang-ru">Как собран этот сайт</span>
      </h1>
      <p class="bs-lead">
        <span class="lang-en">
          Agents wrote the code, I did the planning. That is easy to say, so here are the receipts: every merged PR of this
          site, with the test committed red before the code (all but the first PR, made before this loop), what was caught
          before merge, and what I decided.
        </span>
        <span class="lang-ru">
          Код писали агенты, планировал я. Сказать легко, поэтому вот доказательства: каждый смерженный PR этого сайта —
          с тестом, закоммиченным красным до кода (кроме самого первого, сделанного до этого цикла), с тем, что поймали
          до мержа, и с тем, что решил я.
        </span>
      </p>
      <p class="fine-print">
        <span class="lang-en">
          The PR count and percentages on <a class="text-link" href="/">the home page</a> are about my work at YAGNI, not
          this site. This page shows the same loop on this site’s own PRs.
        </span>
        <span class="lang-ru">
          Число PR и проценты на <a class="text-link" href="/">главной</a> — про мою работу в YAGNI, а не про этот сайт.
          Здесь тот же цикл на PR самого сайта.
        </span>
      </p>

      <h2 class="bs-h2">
        <span class="lang-en">How the loop runs now</span>
        <span class="lang-ru">Как сейчас устроен цикл</span>
      </h2>
      <ol class="bs-loop" role="list">
        {LOOP.map((s) => (
          <li class:list={['bs-step', { 'bs-step-human': s.human }]}>
            <strong>
              <span class="lang-en">{s.en}</span>
              <span class="lang-ru">{s.ru}</span>
            </strong>
            <span class="bs-step-note">
              <span class="lang-en">{s.noteEn}</span>
              <span class="lang-ru">{s.noteRu}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="fine-print">
        <span class="lang-en">
          Judge and fix repeat until every confirmed finding is fixed. Highlighted steps are mine. The loop grew over these
          PRs: a card mentions a review only where its PR says one ran.
        </span>
        <span class="lang-ru">
          Судья и фикс повторяются, пока не исправлено каждое подтверждённое замечание. Выделенные шаги — мои. Цикл
          складывался по ходу этих PR: ревью упомянуто в карточке, только если о нём сказано в самом PR.
        </span>
      </p>

      <div class="bs-stats">
        <div class="stat-card">
          <span class="stat-val" data-stat="prs">{stats.prs}</span>
          <div class="stat-lbl"><span class="lang-en">Merged PRs</span><span class="lang-ru">Смерженных PR</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-val" data-stat="red-first">{`${stats.redFirst}/${stats.prs}`}</span>
          <div class="stat-lbl"><span class="lang-en">Red test first</span><span class="lang-ru">Красный тест первым</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-val" data-stat="findings">{stats.findings}</span>
          <div class="stat-lbl"><span class="lang-en">Findings highlighted</span><span class="lang-ru">Выделенных находок</span></div>
        </div>
        <div class="stat-card">
          <span class="stat-val" data-stat="commits">{stats.commits}</span>
          <div class="stat-lbl"><span class="lang-en">Commits, no merges</span><span class="lang-ru">Коммитов без мержей</span></div>
        </div>
      </div>

      <h2 class="bs-h2">
        <span class="lang-en">Every PR, oldest first</span>
        <span class="lang-ru">Все PR, от первого</span>
      </h2>
      <div class="bs-timeline">
        {prs.map((p) => {
          const g = p.green;
          const commits = p.commits.filter((c) => c.role !== 'merge').length;
          return (
            <>
              <article class="brutal-box bs-card" data-pr={p.number}>
                <div class="bs-card-head">
                  <span class="label">
                    PR #{p.number} · <span class="lang-en">merged</span><span class="lang-ru">смержен</span>{' '}
                    <time datetime={p.mergedAt}>{day(p.mergedAt)}</time>
                  </span>
                  <h3 class="bs-card-title" lang="en">{p.title}</h3>
                </div>
                <dl class="bs-rows">
                  <div>
                    <dt class="label"><span class="lang-en">For visitors</span><span class="lang-ru">Для посетителей</span></dt>
                    <dd>
                      <span class="lang-en">{p.visitorChange.en}</span>
                      <span class="lang-ru">{p.visitorChange.ru}</span>
                    </dd>
                  </div>
                  <div>
                    <dt class="label">
                      {g ? (
                        <><span class="lang-en">Red → green</span><span class="lang-ru">Красный → зелёный</span></>
                      ) : (
                        <><span class="lang-en">Red test</span><span class="lang-ru">Красный тест</span></>
                      )}
                    </dt>
                    <dd>
                      {p.redTest ? (
                        <>
                          <a class="text-link bs-sha" href={p.redTest.url} aria-label={`commit ${short(p.redTest.sha)}`}>{short(p.redTest.sha)}</a>{' '}
                          <span lang="en">{p.redTest.subject}</span>
                          {g && (
                            <span class="bs-green">
                              {' → '}
                              <a class="text-link bs-sha" href={g.url} aria-label={`commit ${short(g.sha)}`}>{short(g.sha)}</a>{' '}
                              <span lang="en">{g.subject}</span>
                            </span>
                          )}
                        </>
                      ) : (
                        <>
                          <span class="lang-en">{p.preLoop!.en}</span>
                          <span class="lang-ru">{p.preLoop!.ru}</span>
                        </>
                      )}
                    </dd>
                  </div>
                  {p.review && (
                    <div>
                      <dt class="label"><span class="lang-en">Review</span><span class="lang-ru">Ревью</span></dt>
                      <dd>
                        <span class="lang-en">{p.review.en}</span>
                        <span class="lang-ru">{p.review.ru}</span>
                      </dd>
                    </div>
                  )}
                  {p.findings.length > 0 && (
                    <div>
                      <dt class="label"><span class="lang-en">Caught before merge</span><span class="lang-ru">Поймано до мержа</span></dt>
                      <dd>
                        <ul class="bs-findings">
                          {p.findings.map((f) => (
                            <li>
                              <span class="lang-en">{f.en}</span>
                              <span class="lang-ru">{f.ru}</span>
                              {/* A finding pinned to the PR as a whole links through the card's own PR link below. */}
                              {f.ref !== p.url && (
                                <>
                                  {' '}
                                  <a class="text-link bs-sha" href={f.ref} aria-label={`commit ${short(f.ref.split('/').pop()!)}`}>
                                    {short(f.ref.split('/').pop()!)}
                                  </a>
                                </>
                              )}
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  )}
                  <div>
                    <dt class="label"><span class="lang-en">What I decided</span><span class="lang-ru">Что решил я</span></dt>
                    <dd>
                      <span class="lang-en">{p.humanDecision.en}</span>
                      <span class="lang-ru">{p.humanDecision.ru}</span>
                    </dd>
                  </div>
                </dl>
                <div class="bs-card-foot">
                  <a class="text-link" href={p.url}>
                    <span class="lang-en">PR #{p.number} on GitHub ↗</span>
                    <span class="lang-ru">PR #{p.number} на GitHub ↗</span>
                  </a>
                  <span class="label">
                    +{p.additions} −{p.deletions} · {p.changedFiles} <span class="lang-en">files</span><span class="lang-ru">файлов</span>
                    · {commits} <span class="lang-en">commits</span><span class="lang-ru">коммитов</span>
                  </span>
                </div>
              </article>
              <Fragment set:html={`<!-- /pr-${p.number} -->`} />
            </>
          );
        })}
      </div>

      <div class="bs-cta">
        <p class="bs-lead">
          <span class="lang-en">If you build with agents and want a loop like this on your repo, happy to talk it through.</span>
          <span class="lang-ru">Если вы работаете с агентами и хотите такой же цикл в своём репозитории — давайте обсудим.</span>
        </p>
        <a
          href={calUrl('build-story')}
          data-track="cta_book"
          data-track-placement="build-story"
          target="_blank"
          rel="noopener noreferrer"
          class="brutal-btn"
        >
          <span class="lang-en">BOOK A 30-MIN CALL ↗</span>
          <span class="lang-ru">ЗАБРОНИРОВАТЬ СОЗВОН ↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bs-wrap {
    max-width: 860px;
  }
  .bs-back {
    display: block;
    width: fit-content;
    margin-bottom: 18px;
  }
  .bs-lead {
    font-size: 1.05rem;
    line-height: 1.5;
    max-width: 62ch;
    margin: 14px 0 8px;
  }
  .bs-h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 36px 0 14px;
  }

  /* The loop: flat boxes (information, not controls) joined by arrows; stacks on phones. */
  .bs-loop {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    counter-reset: step;
  }
  .bs-step {
    position: relative;
    border: 2px solid var(--border);
    background: var(--surface);
    padding: 10px 12px;
    counter-increment: step;
  }
  .bs-step strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    text-transform: uppercase;
  }
  .bs-step strong::before {
    content: counter(step) '. ';
    color: var(--ink-muted);
  }
  .bs-step-note {
    display: block;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--ink-muted);
    margin-top: 4px;
  }
  .bs-step-human {
    border-left-width: 8px;
    border-left-color: var(--lime);
  }
  .bs-step:not(:last-child)::after {
    content: '→' / '';
    position: absolute;
    right: -21px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-weight: 800;
    color: currentColor;
  }
  /* Two rows read as a snake: 1 → 2 → 3, down, then 4 ← 5 ← 6 back along the second row. */
  .bs-step:nth-child(3)::after {
    content: '↓' / '';
    right: auto;
    left: 50%;
    top: auto;
    bottom: -24px;
    transform: none;
  }
  .bs-step:nth-child(4) { grid-area: 2 / 3; }
  .bs-step:nth-child(5) { grid-area: 2 / 2; }
  .bs-step:nth-child(6) { grid-area: 2 / 1; }
  .bs-step:nth-child(4)::after,
  .bs-step:nth-child(5)::after {
    content: '←' / '';
    right: auto;
    left: -21px;
  }

  .bs-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 28px;
  }

  .bs-timeline {
    display: grid;
    gap: 18px;
  }
  .bs-card {
    padding: 18px 20px;
  }
  .bs-card-title {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 6px 0 12px;
  }
  .bs-rows {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .bs-rows > div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 12px;
    border-top: 1px solid var(--surface-alt);
    padding-top: 10px;
  }
  .bs-rows dd {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .bs-sha {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .bs-findings {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .bs-card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 14px;
  }

  .bs-cta {
    margin-top: 40px;
    border-top: 2px solid var(--border);
    padding-top: 18px;
  }

  @media (max-width: 640px) {
    .bs-loop {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .bs-step:nth-child(n) {
      grid-area: auto;
    }
    .bs-step:not(:last-child)::after,
    .bs-step:nth-child(n)::after {
      content: '↓' / '';
      right: auto;
      left: 50%;
      top: auto;
      bottom: -21px;
      transform: none;
    }
    .bs-step:last-child::after {
      content: none;
    }
    .bs-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .bs-rows > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .bs-card {
      padding: 14px;
    }
  }
</style>
