---
// One page of /writing/: the topic links, 12 post cards and the pager (src/data/writing-pages.ts).
// "Show more" is a plain link to the next page; scripts/show-more.ts appends that page's cards in place.
import { postPath } from '../data/profile';
import { TOPICS, pageCount, pagePosts, topicPosts, writingPath, type TopicOrAll } from '../data/writing-pages';
import Base from '../layouts/Base.astro';
import Creature from './Creature.astro';
import { localePath, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  topic: TopicOrAll;
  page: number;
}
const { lang, topic, page } = Astro.props;
const d = t(lang);
const label = (x: TopicOrAll) =>
  ({ all: d.writing.filterAll, ai: d.writing.filterAi, leadership: d.writing.filterLeadership, systems: d.writing.filterSystems, delivery: d.writing.filterDelivery })[x];
const posts = pagePosts(topic, page);
const pages = pageCount(topic);
const href = (p: number) => localePath(lang, writingPath(topic, p));
const title = d.writing.pageTitle(topic === 'all' ? null : label(topic), page);
const description = topic === 'all' ? d.meta.writingDescription : d.writing.topicDescription(label(topic), topicPosts(topic).length);
---

<Base title={title} description={description}>
  <section class="section-block">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-kicker">{d.writing.kicker}{page > 1 && ` · ${d.writing.page(page)}`}</span>
          <h1 class="section-title">{topic === 'all' ? d.writing.title : label(topic)}</h1>
        </div>
      </div>

      <nav class="filter-bar" aria-label={d.writing.topicsLabel}>
        {(['all', ...TOPICS] as TopicOrAll[]).map((x) => (
          <a
            class:list={['filter-tab', { active: x === topic }]}
            href={localePath(lang, writingPath(x))}
            aria-current={x === topic ? 'page' : undefined}
            data-track="post_filter"
            data-track-filter={x}
          >
            {label(x)}
          </a>
        ))}
      </nav>

      {/* data-reading-*: the words on read and started cards (scripts/reading.ts), in this page's language. */}
      <div class="posts-grid" data-reading-read={d.reading.read} data-reading-part={d.reading.part}>
        {posts.map((post) => (
          <article class="brutal-box post-card" data-slug={post.slug}>
            <div>
              <div class="post-top">
                {/* The creature and the category sit together on the left; the date or read time stays right. */}
                <span style="display: inline-flex; align-items: center; gap: 8px;">
                  <Creature slug={post.slug} color={post.color} size={28} />
                  <span class="label">{post.categoryLabel[lang]}</span>
                </span>
                <time class="post-stats" datetime={post.published}>{post.published}</time>
              </div>
              {/* vt-card: named only when this card is clicked (scripts/site.ts), so one title flies, not all of them. */}
              <h2 class="post-title vt-card" style={`--vt: post-${post.slug}`}>
                <a href={localePath(lang, postPath(post))}>{post.title[lang]}</a>
              </h2>
              <div class="post-takeaway">{post.takeaway[lang]}</div>
            </div>
            <div class="post-actions">
              <a class="text-link" href={localePath(lang, postPath(post))}>{d.writing.readBriefLink}</a>
            </div>
          </article>
        ))}
      </div>

      {page < pages && (
        <div class="writing-more" data-more-wrap>
          <a class="brutal-btn" href={href(page + 1)} data-more=".posts-grid">{d.writing.more} ↓</a>
        </div>
      )}

      {pages > 1 && (
        <nav class="writing-pager" aria-label={d.writing.pagerLabel} data-pager>
          {Array.from({ length: pages }, (_, i) => i + 1).map((p) =>
            p === page ? (
              <span class="ctrl-btn active-lang" aria-current="page">{p}</span>
            ) : (
              <a class="ctrl-btn" href={href(p)} aria-label={d.writing.page(p)}>{p}</a>
            ),
          )}
        </nav>
      )}

      <p data-reading-note hidden style="margin-top: 22px; font-size: 0.85rem; color: var(--ink-muted);">
        {d.reading.note} <button type="button" class="text-link" data-reading-forget style="background: none; border: 0; padding: 0; cursor: pointer; font: inherit;">{d.reading.forget}</button>
      </p>
    </div>
  </section>
  <Fragment slot="scripts">
    <script>
      import { initReadingList } from '../scripts/reading';
      initReadingList();
    </script>
  </Fragment>
</Base>
