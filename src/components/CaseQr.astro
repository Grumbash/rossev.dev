---
// The QR code from the phone case: HTTPS://ROSSEV.DEV/C in capitals (alphanumeric mode keeps it small),
// level Q, round data dots, rounded finders with a lime gap. Encoded at build time, so the page ships
// plain SVG and no JS. Always dark on light, whatever the theme: not every camera reads an inverted code.
import qrcode from 'qrcode-generator';

interface Props {
  label: string;
}
const { label } = Astro.props;

const qr = qrcode(0, 'Q');
qr.addData('HTTPS://ROSSEV.DEV/C', 'Alphanumeric');
qr.make();
const n = qr.getModuleCount();
const QUIET = 4;
const size = n + 2 * QUIET;
const FINDERS = [[0, 0], [0, n - 7], [n - 7, 0]];
const inFinder = (r: number, c: number) => FINDERS.some(([fr, fc]) => r >= fr && r < fr + 7 && c >= fc && c < fc + 7);
const dots: [number, number][] = [];
for (let r = 0; r < n; r++) for (let c = 0; c < n; c++) if (qr.isDark(r, c) && !inFinder(r, c)) dots.push([r, c]);
---

<svg class="hire-qr-code" viewBox={`0 0 ${size} ${size}`} role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
  {/* Square: the page rounds the frame with border-radius, which clips this background with it. */}
  <rect width={size} height={size} fill="#F2EEE6" />
  <g fill="#0A0A0A">{dots.map(([r, c]) => <circle cx={QUIET + c + 0.5} cy={QUIET + r + 0.5} r="0.49" />)}</g>
  {FINDERS.map(([r, c]) => (
    <g>
      <rect x={QUIET + c + 1} y={QUIET + r + 1} width="5" height="5" rx="1.1" fill="#C8FF00" />
      <rect x={QUIET + c + 0.5} y={QUIET + r + 0.5} width="6" height="6" rx="1.6" fill="none" stroke="#0A0A0A" stroke-width="1" />
      <rect x={QUIET + c + 2} y={QUIET + r + 2} width="3" height="3" rx="0.9" fill="#0A0A0A" />
    </g>
  ))}
</svg>
