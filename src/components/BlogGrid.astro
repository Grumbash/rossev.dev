---
import { postPath, type BlogPost } from '../data/profile';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<div class="posts-grid">
  {posts.map((post) => (
    <article class="brutal-box post-card">
      <div>
        <div class="post-top">
          <span class="label">
            <span class="lang-en">{post.categoryLabel.en}</span>
            <span class="lang-ru">{post.categoryLabel.ru}</span>
          </span>
          <span class="post-stats">
            <span class="lang-en">{post.originalMinutes}-MIN ORIGINAL</span>
            <span class="lang-ru">ОРИГИНАЛ {post.originalMinutes} МИН</span>
          </span>
        </div>

        <h3 class="post-title">
          <span class="lang-en">{post.title.en}</span>
          <span class="lang-ru">{post.title.ru}</span>
        </h3>

        <div class="post-takeaway">
          <span class="lang-en">{post.takeaway.en}</span>
          <span class="lang-ru">{post.takeaway.ru}</span>
        </div>

        <div class="post-tags">{post.tags.map((tag) => `#${tag}`).join('  ')}</div>
      </div>

      <div class="post-actions">
        <!-- A real link to the post page (crawlers, new tabs, no JS); a plain click opens the brief
             inline instead. htmx cancels the default of any click it handles, so it listens for
             open-brief, fired by window.openBrief only for an unmodified left click. -->
        <a
          href={postPath(post)}
          class="brutal-btn brutal-btn-sm"
          hx-get={`/partials/post-${post.id}`}
          hx-trigger="open-brief"
          data-track="post_open"
          data-track-id={post.id}
          hx-target="#post-reader-slot"
          hx-swap="innerHTML transition:true"
          onclick="window.openBrief && window.openBrief(this, event)"
        >
          <span class="lang-en">READ BRIEF</span>
          <span class="lang-ru">ЧИТАТЬ РАЗБОР</span>
        </a>

        <a class="text-link" href={post.url} target="_blank" rel="noopener noreferrer" data-track="post_linkedin" data-track-id={post.id}>
          LinkedIn ↗
        </a>
      </div>
    </article>
  ))}
</div>
