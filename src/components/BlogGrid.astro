---
import type { BlogPost } from '../data/profile';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<div class="posts-grid">
  {posts.map((post) => (
    <article class="brutal-box post-card">
      <div>
        <div class="post-top">
          <span class="label">
            <span class="lang-en">{post.categoryLabel.en}</span>
            <span class="lang-ru">{post.categoryLabel.ru}</span>
          </span>
          <span class="post-stats">
            <span class="lang-en">{post.readTime.en}</span>
            <span class="lang-ru">{post.readTime.ru}</span>
          </span>
        </div>

        <h3 class="post-title">
          <span class="lang-en">{post.title.en}</span>
          <span class="lang-ru">{post.title.ru}</span>
        </h3>

        <div class="post-takeaway">
          <span class="lang-en">{post.takeaway.en}</span>
          <span class="lang-ru">{post.takeaway.ru}</span>
        </div>

        <div class="post-tags">{post.tags.map((tag) => `#${tag}`).join('  ')}</div>
      </div>

      <div class="post-actions">
        <button
          type="button"
          class="brutal-btn brutal-btn-sm"
          hx-get={`/partials/post-${post.id}`}
          hx-target="#post-reader-slot"
          hx-swap="innerHTML transition:true"
          onclick={`window.setUrlParam && window.setUrlParam('post', '${post.id}'); setTimeout(() => document.getElementById('post-reader-slot')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 120)`}
        >
          <span class="lang-en">READ BRIEF</span>
          <span class="lang-ru">ЧИТАТЬ РАЗБОР</span>
        </button>

        <a class="text-link" href={post.url} target="_blank" rel="noopener noreferrer">
          LinkedIn ↗
        </a>
      </div>
    </article>
  ))}
</div>
