---
import type { BlogPost } from '../data/profile';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<div class="posts-grid">
  {posts.map((post) => (
    <article class="brutal-box brutal-box-hover post-card" data-tilt>
      <div>
        <div class="post-top">
          <span class="post-cat" style={`background: ${post.color};`}>
            <span class="lang-en">{post.categoryLabel.en}</span>
            <span class="lang-ru">{post.categoryLabel.ru}</span>
          </span>
          <span class="post-stats">
            <span class="lang-en">{post.readTime.en}</span>
            <span class="lang-ru">{post.readTime.ru}</span>
          </span>
        </div>

        <h3 class="post-title">
          <span class="lang-en">{post.title.en}</span>
          <span class="lang-ru">{post.title.ru}</span>
        </h3>

        <div class="post-takeaway">
          <span class="lang-en">{post.takeaway.en}</span>
          <span class="lang-ru">{post.takeaway.ru}</span>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px;">
          {post.tags.map((tag) => (
            <span class="brutal-tag" style="font-size: 0.68rem; padding: 2px 8px;">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      <div style="display: flex; gap: 8px;">
        <button
          type="button"
          class="brutal-btn brutal-btn-lime"
          style="flex: 1; justify-content: center; padding: 9px 12px; font-size: 0.75rem;"
          hx-get={`/partials/post-${post.id}`}
          hx-target="#post-reader-slot"
          hx-swap="innerHTML"
          onclick="setTimeout(() => document.getElementById('post-reader-slot')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 120)"
        >
          <span class="lang-en">READ BRIEF</span>
          <span class="lang-ru">ЧИТАТЬ РАЗБОР</span>
        </button>

        <a
          href={post.url}
          target="_blank"
          rel="noopener noreferrer"
          class="brutal-btn brutal-btn-surface"
          style="padding: 9px 11px; font-size: 0.75rem;"
          title="Open on LinkedIn"
        >
          <span>IN ↗</span>
        </a>
      </div>
    </article>
  ))}
</div>
