---
import { cardReadTime, postPath, type BlogPost } from '../data/profile';
import { localePath, t, type Locale } from '../i18n';
import Creature from './Creature.astro';

interface Props {
  posts: BlogPost[];
  lang: Locale;
}

const { posts, lang } = Astro.props;
const d = t(lang);
---

{/* Home's cards: category, read time, title and the way in. Their size must not depend on the
    post, since the Publora sync keeps adding posts (tests/home-flat.test.ts): the takeaway, tags
    and the LinkedIn link live on /writing/, in the brief and on the post page. */}
<div class="posts-grid" data-reading-read={d.reading.read} data-reading-part={d.reading.part}>
  {posts.map((post) => (
    <article class="brutal-box post-card" data-slug={post.slug}>
      <div>
        <div class="post-top">
          {/* The creature and the category sit together on the left; the date or read time stays right. */}
          <span style="display: inline-flex; align-items: center; gap: 8px;">
            <Creature slug={post.slug} color={post.color} size={28} />
            <span class="label">{post.categoryLabel[lang]}</span>
          </span>
          <span class="post-stats">{cardReadTime(post)[lang]}</span>
        </div>

        <h3 class="post-title">{post.title[lang]}</h3>
      </div>

      <div class="post-actions">
        {/* A real link to the post page (crawlers, new tabs, no JS); a plain click opens the brief
             inline instead. htmx cancels the default of any click it handles, so it listens for
             open-brief, fired by window.openBrief only for an unmodified left click. */}
        <a
          href={localePath(lang, postPath(post))}
          class="brutal-btn brutal-btn-sm"
          hx-get={localePath(lang, `/partials/post-${post.id}`)}
          hx-trigger="open-brief"
          data-track="post_open"
          data-track-id={post.id}
          hx-target="#post-reader-slot"
          hx-swap="innerHTML transition:true"
          data-action="openBrief"
        >
          {d.writing.readBrief}
        </a>
      </div>
    </article>
  ))}
</div>
