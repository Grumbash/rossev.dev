<!-- Synchronous anti-FOUC theme before first paint: a saved pick, else the system's (scripts/theme.ts) -->
<script is:inline>var r=document.documentElement,m=null;try{m=localStorage.getItem('rosev_theme')}catch(e){}if(m!='light'&&m!='dark')m='system';r.setAttribute('data-theme-mode',m);r.setAttribute('data-theme',m=='dark'||m=='system'&&matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')</script>
