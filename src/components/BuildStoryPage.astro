---
// The receipts for "agents wrote the code, I did the planning": every merged PR of this site with its
// red test, what was caught before merge, what I decided, and links to the real commits. A review or
// judge is shown only where the PR itself says one ran (`review`), never implied. A PR the workflow
// added before I wrote its notes is `pending`: its card shows only facts, never placeholder copy. Renders
// src/data/build-story.json (made by `bun run build-story`); every number here is computed from it.
// The PRs come newest first, 10 to a page (src/data/build-pages.ts): page 1 is /how-its-built/ with
// the loop and the stats, pages 2+ are /how-its-built/page/<n>/ with just the cards.
import Base from '../layouts/Base.astro';
import story from '../data/build-story.json';
import { buildPageCount, buildPagePath, buildPagePrs } from '../data/build-pages';
import { computeStats, type Entry } from '../../scripts/build-story';
import { calUrl } from '../scripts/analytics';
import { localePath, t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  page: number;
}
const { lang, page } = Astro.props;
const d = t(lang);
const b = d.build;

const SITE = 'https://rossev.dev/';
const PERSON_ID = `${SITE}#person`;
const url = new URL(localePath(lang, buildPagePath(page)), SITE).toString();
const ogImageUrl = new URL('/og-card.png', SITE).toString();
const homePath = localePath(lang, '/');

const prs = story.prs as Entry[];
// Stats always count every PR; the cards are this page's ten.
const stats = computeStats(prs);
const cards = buildPagePrs(prs, page);
const pages = buildPageCount(prs);
const pageHref = (n: number) => localePath(lang, buildPagePath(n));
const first = page === 1;
const lastMerged = prs.reduce((d, p) => (p.mergedAt > d ? p.mergedAt : d), '');
// The page's own first publish date; dateModified follows the data.
const PUBLISHED = '2026-11-04';
const day = (iso: string) => iso.slice(0, 10);
const short = (sha: string) => sha.slice(0, 7);

const title = first ? d.meta.buildTitle : b.pageTitle(page);
const description = first ? d.meta.buildDescription : b.pageDescription(page, prs.length);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${url}#article`,
      headline: d.meta.buildHeadline,
      description,
      url,
      mainEntityOfPage: { '@id': url },
      datePublished: PUBLISHED,
      dateModified: lastMerged,
      author: { '@id': PERSON_ID },
      publisher: { '@id': PERSON_ID },
      isPartOf: { '@id': `${SITE}#website` },
      inLanguage: lang,
      image: ogImageUrl
    },
    // The full Person node lives on home; this is enough to resolve the @id here.
    {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Gleb Rosev',
      url: SITE,
      sameAs: ['https://www.linkedin.com/in/rossev/', 'https://github.com/Grumbash']
    }
  ]
};

const LOOP = [
  { name: b.loopFraming, note: b.loopFramingNote, human: true },
  { name: b.loopRed, note: b.loopRedNote, human: false },
  { name: b.loopWriter, note: b.loopWriterNote, human: false },
  { name: b.loopJudge, note: b.loopJudgeNote, human: false },
  { name: b.loopFix, note: b.loopFixNote, human: false },
  { name: b.loopMerge, note: b.loopMergeNote, human: true }
];
---

<Base title={title} description={description} ogType={first ? 'article' : undefined} jsonLd={first ? jsonLd : undefined} cta={false}>
  <section class="section-block">
    <div class="container bs-wrap">
      {!first && (
        <>
          <a class="text-link bs-back" href={pageHref(1)}>{b.backToStory}</a>
          <span class="section-kicker">{b.kicker}</span>
          <h1 class="section-title">{b.pageHeading(page)}</h1>
        </>
      )}
      {first && (
      <>
      <a class="text-link bs-back" href={homePath}>{b.home}</a>

      <span class="section-kicker">{b.kicker}</span>
      <h1 class="section-title">{b.title}</h1>
      <p class="bs-lead">{b.lead}</p>
      <p class="fine-print" set:html={b.scopeHtml(homePath)} />

      <h2 class="bs-h2">{b.loopTitle}</h2>
      <ol class="bs-loop" role="list">
        {LOOP.map((s) => (
          <li class:list={['bs-step', { 'bs-step-human': s.human }]}>
            <strong>{s.name}</strong>
            <span class="bs-step-note">{s.note}</span>
          </li>
        ))}
      </ol>
      <p class="fine-print">{b.loopNote}</p>

      <div class="bs-stats">
        <div class="stat-card">
          <span class="stat-val" data-stat="prs">{stats.prs}</span>
          <div class="stat-lbl">{b.statPrs}</div>
        </div>
        <div class="stat-card">
          <span class="stat-val" data-stat="red-first">{`${stats.redFirst}/${stats.prs}`}</span>
          <div class="stat-lbl">{b.statRedFirst}</div>
        </div>
        <div class="stat-card">
          <span class="stat-val" data-stat="findings">{stats.findings}</span>
          <div class="stat-lbl">{b.statFindings}</div>
        </div>
        <div class="stat-card">
          <span class="stat-val" data-stat="commits">{stats.commits}</span>
          <div class="stat-lbl">{b.statCommits}</div>
        </div>
      </div>

      <h2 class="bs-h2">{b.prsTitle}</h2>
      </>
      )}
      <div class="bs-timeline">
        {cards.map((p) => {
          const g = p.green;
          const commits = p.commits.filter((c) => c.role !== 'merge').length;
          return (
            <>
              <article class="brutal-box bs-card" data-pr={p.number} data-pending={p.pending ? '' : undefined}>
                <div class="bs-card-head">
                  <span class="label">
                    PR #{p.number} · {b.merged}{' '}
                    <time datetime={p.mergedAt}>{day(p.mergedAt)}</time>
                  </span>
                  {lang === 'ru' && p.titleRu ? <h3 class="bs-card-title">{p.titleRu}</h3> : <h3 class="bs-card-title" lang="en">{p.title}</h3>}
                </div>
                {p.pending && <p class="bs-pending">{b.pending}</p>}
                <dl class="bs-rows">
                  {p.visitorChange && (
                    <div>
                      <dt class="label">{b.forVisitors}</dt>
                      <dd>{p.visitorChange[lang]}</dd>
                    </div>
                  )}
                  <div>
                    <dt class="label">
                      {g ? b.redGreen : b.redTest}
                    </dt>
                    <dd>
                      {p.redTest ? (
                        <>
                          <a class="text-link bs-sha" href={p.redTest.url} aria-label={`commit ${short(p.redTest.sha)}`}>{short(p.redTest.sha)}</a>{' '}
                          <span lang="en">{p.redTest.subject}</span>
                          {g && (
                            <span class="bs-green">
                              {' → '}
                              <a class="text-link bs-sha" href={g.url} aria-label={`commit ${short(g.sha)}`}>{short(g.sha)}</a>{' '}
                              <span lang="en">{g.subject}</span>
                            </span>
                          )}
                        </>
                      ) : (p.preLoop ?? p.noRedTest) ? (
                        <>{(p.preLoop ?? p.noRedTest)![lang]}</>
                      ) : (
                        <>{b.noRedTest}</>
                      )}
                    </dd>
                  </div>
                  {p.review && (
                    <div>
                      <dt class="label">{b.review}</dt>
                      <dd>{p.review[lang]}</dd>
                    </div>
                  )}
                  {p.findings.length > 0 && (
                    <div>
                      <dt class="label">{b.caught}</dt>
                      <dd>
                        <ul class="bs-findings">
                          {p.findings.map((f) => (
                            <li>
                              {f[lang]}
                              {/* A finding pinned to the PR as a whole links through the card's own PR link below. */}
                              {f.ref !== p.url && (
                                <>
                                  {' '}
                                  <a class="text-link bs-sha" href={f.ref} aria-label={`commit ${short(f.ref.split('/').pop()!)}`}>
                                    {short(f.ref.split('/').pop()!)}
                                  </a>
                                </>
                              )}
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  )}
                  {p.humanDecision && (
                    <div>
                      <dt class="label">{b.decided}</dt>
                      <dd>{p.humanDecision[lang]}</dd>
                    </div>
                  )}
                </dl>
                <div class="bs-card-foot">
                  <a class="text-link" href={p.url}>{b.onGithub(p.number)}</a>
                  <span class="label">
                    +{p.additions} −{p.deletions} · {p.changedFiles} {b.files}
                    · {commits} {b.commits}
                  </span>
                </div>
              </article>
              <Fragment set:html={`<!-- /pr-${p.number} -->`} />
            </>
          );
        })}
      </div>

      {page < pages && (
        <div class="writing-more" data-more-wrap>
          <a class="brutal-btn" href={pageHref(page + 1)} data-more=".bs-timeline">{b.more} ↓</a>
        </div>
      )}

      {pages > 1 && (
        <nav class="writing-pager" aria-label={b.pagerLabel} data-pager>
          {Array.from({ length: pages }, (_, i) => i + 1).map((n) =>
            n === page ? (
              <span class="ctrl-btn active-lang" aria-current="page">{n}</span>
            ) : (
              <a class="ctrl-btn" href={pageHref(n)} aria-label={b.page(n)}>{n}</a>
            ),
          )}
        </nav>
      )}

      <div class="bs-cta">
        <p class="bs-lead">{b.ctaLead}</p>
        <a
          href={calUrl('build-story', lang)}
          data-track="cta_book"
          data-track-placement="build-story"
          target="_blank"
          rel="noopener noreferrer"
          class="brutal-btn"
        >
          {b.cta}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bs-wrap {
    max-width: 860px;
  }
  .bs-back {
    display: block;
    width: fit-content;
    margin-bottom: 18px;
  }
  .bs-lead {
    font-size: 1.05rem;
    line-height: 1.5;
    max-width: 62ch;
    margin: 14px 0 8px;
  }
  .bs-h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    margin: 36px 0 14px;
  }

  /* The loop: flat boxes (information, not controls) joined by arrows; stacks on phones. */
  .bs-loop {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    counter-reset: step;
  }
  .bs-step {
    position: relative;
    border: 2px solid var(--border);
    background: var(--surface);
    padding: 10px 12px;
    counter-increment: step;
  }
  .bs-step strong {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    text-transform: uppercase;
  }
  .bs-step strong::before {
    content: counter(step) '. ';
    color: var(--ink-muted);
  }
  .bs-step-note {
    display: block;
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--ink-muted);
    margin-top: 4px;
  }
  .bs-step-human {
    border-left-width: 8px;
    border-left-color: var(--lime);
  }
  .bs-step:not(:last-child)::after {
    content: '→' / '';
    position: absolute;
    right: -21px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-weight: 800;
    color: currentColor;
  }
  /* Two rows read as a snake: 1 → 2 → 3, down, then 4 ← 5 ← 6 back along the second row. */
  .bs-step:nth-child(3)::after {
    content: '↓' / '';
    right: auto;
    left: 50%;
    top: auto;
    bottom: -24px;
    transform: none;
  }
  .bs-step:nth-child(4) { grid-area: 2 / 3; }
  .bs-step:nth-child(5) { grid-area: 2 / 2; }
  .bs-step:nth-child(6) { grid-area: 2 / 1; }
  .bs-step:nth-child(4)::after,
  .bs-step:nth-child(5)::after {
    content: '←' / '';
    right: auto;
    left: -21px;
  }

  .bs-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 28px;
  }

  .bs-timeline {
    display: grid;
    gap: 18px;
  }
  .bs-card {
    padding: 18px 20px;
  }
  .bs-card-title {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 6px 0 12px;
  }
  .bs-rows {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .bs-rows > div {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 12px;
    border-top: 1px solid var(--surface-alt);
    padding-top: 10px;
  }
  .bs-rows dd {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .bs-sha {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .bs-findings {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
  }
  .bs-pending {
    margin: 0 0 10px;
    font-size: 0.86rem;
    color: var(--ink-muted);
    border-left: 4px solid var(--border);
    padding-left: 10px;
  }
  .bs-card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 14px;
  }

  .bs-cta {
    margin-top: 40px;
    border-top: 2px solid var(--border);
    padding-top: 18px;
  }

  @media (max-width: 640px) {
    .bs-loop {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .bs-step:nth-child(n) {
      grid-area: auto;
    }
    .bs-step:not(:last-child)::after,
    .bs-step:nth-child(n)::after {
      content: '↓' / '';
      right: auto;
      left: 50%;
      top: auto;
      bottom: -21px;
      transform: none;
    }
    .bs-step:last-child::after {
      content: none;
    }
    .bs-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .bs-rows > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .bs-card {
      padding: 14px;
    }
  }
</style>
