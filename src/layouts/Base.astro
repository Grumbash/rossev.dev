---
// Shared chrome for every page: <head> (meta, hreflang, fonts, theme bootstrap, analytics), nav,
// contact footer, toast and the global helpers (theme, URL params, clipboard). The locale comes from
// the URL (/ru/... is Russian); each page exists once per locale, see src/i18n/index.ts.
// Page-specific scripts go in the "scripts" slot; page-specific <head> bits in the "head" slot.
import '@fontsource-variable/jetbrains-mono/wght.css';
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/syne/wght.css';
import '../styles/fonts-cyrillic.css';
import '../styles/brutalism.css';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import groteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import syneLatin from '@fontsource-variable/syne/files/syne-latin-wght-normal.woff2?url';
import ThemeBootstrap from '../components/ThemeBootstrap.astro';
import { existsSync } from 'node:fs';
import { PROFILE } from '../data/profile';
import { commitUrl, lastCommit } from '../data/now';
import { calUrl } from '../scripts/analytics';
import { DEFAULT_LOCALE, LOCALES, SITE, localePath, splitLocale, t } from '../i18n';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  jsonLd?: object;
  // Home links its sections as #anchors; every other page as /#anchors. Writing is the exception:
  // the nav sends it to /writing/, the full list, since home shows only the latest posts.
  home?: boolean;
  // Nav and footer "book a call" buttons. Post pages turn them off: the reader footer has the one CTA.
  cta?: boolean;
  // htmx is only needed where partials are swapped in (home).
  htmx?: boolean;
  // The share preview: a post page passes its own (/og/<slug>.png, with its creature).
  ogImage?: string;
}

const {
  title,
  description,
  ogType = 'website',
  ogTitle = title,
  ogDescription = description,
  twitterTitle = ogTitle,
  twitterDescription = ogDescription,
  jsonLd,
  home = false,
  cta = true,
  htmx = false
} = Astro.props;

// Every page is canonical in its own locale and lists the others as alternates (x-default: the default locale).
const [lang, path] = splitLocale(Astro.url.pathname.replace(/\/?$/, '/'));
const d = t(lang);
const urlIn = (l: typeof lang) => new URL(localePath(l, path), SITE).toString();
const canonical = urlIn(lang);
const others = LOCALES.filter((l) => l !== lang);
const ogImageUrl = new URL(Astro.props.ogImage ?? '/og-card.png', SITE).toString();
const homePath = localePath(lang, '/');
const anchor = (id: string) => (home ? `#${id}` : `${homePath}#${id}`);

const SPECULATION_RULES = JSON.stringify({
  prefetch: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: ['/partials/*', '/ru/partials/*', '*.pdf', '*.vcf', '*.txt', '*.xml'] } },
          { not: { selector_matches: ['[download]', '[target=_blank]'] } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
});
// "Gleb now" in the footer: the site's last commit, from git at build (scripts/now.ts fills in the rest).
const commit = lastCommit();
// This page's own source, for Alt+click (scripts/insiders.ts): /[...locale]/hire is hire.astro, /[...locale] is its index.astro.
const source = [`src/pages${Astro.routePattern}.astro`, `src/pages${Astro.routePattern}/index.astro`].find((f) => existsSync(f));
---

<!DOCTYPE html>
<html lang={lang} data-theme="light" data-page={home ? 'home' : 'writing'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Hovering a site link prefetches its page (tests/page-transitions.test.ts). Prefetch, never
        prerender: a prerendered page runs its scripts, and Umami would count a view nobody made.
        Allowed by its hash in vercel.json's script-src, like the other inline scripts. */}
    <script is:inline type="speculationrules" set:html={SPECULATION_RULES} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={urlIn(l)} />)}
    <link rel="alternate" hreflang="x-default" href={urlIn(DEFAULT_LOCALE)} />

    {/* Favicon, Manifest & AI Crawler Discovery */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Print only (tests/print.test.ts): a one-page CV on /hire, a newspaper page for a post. */}
    <link rel="stylesheet" href="/print.css" media="print" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI Agent & LLM Context (/llms.txt)" />

    {/* Open Graph / Telegram / Slack / LinkedIn / X Cards (Raster PNG 1200x630) */}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={d.meta.ogLocale} />
    {others.map((l) => <meta property="og:locale:alternate" content={t(l).meta.ogLocale} />)}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={twitterDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Self-hosted fonts (no third-party round trip before first paint) */}
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={syneLatin} as="font" type="font/woff2" crossorigin />

    {/* Structured Data (JSON-LD) */}
    {/* \u003c keeps model-written text (post titles) from closing the script. */}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}

    <ThemeBootstrap />

    {htmx && <script src="/htmx.min.js" defer></script>}

    {/* Umami Cloud: custom funnel events (see README "Analytics") */}
    {import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        data-domains="rossev.dev"
      ></script>
    )}
    {source && <meta name="source" content={source} />}
    <slot name="head" />
  </head>
  <body>
    {/* TOP NAV: text links scroll, buttons act */}
    <header class="top-nav">
      <div class="nav-inner">
        <a href={home ? '#top' : homePath} class="brand-logo">
          <span class="brand-badge">GR</span>
          <span>GLEB ROSEV</span>
        </a>

        <nav class="nav-links" aria-label={d.nav.sections}>
          <a class="nav-link" href={anchor('experience')}>{d.nav.experience}</a>
          <a class="nav-link" href={localePath(lang, '/writing/')} aria-current={path.startsWith('/writing/') ? 'page' : undefined}>{d.nav.writing}</a>
          <a class="nav-link" href={localePath(lang, '/hire/')} aria-current={path === '/hire/' ? 'page' : undefined}>{d.nav.hire}</a>
          <a class="nav-link" href={anchor('contact')}>{d.nav.contact}</a>
        </nav>

        <div class="nav-controls">
          {/* The current language is plain text; the others link to this page in that language.
              site.ts carries ?query and #anchor over on click. */}
          {LOCALES.map((l) =>
            l === lang ? (
              <span class="ctrl-btn active-lang" title={d.nav.current}>{l.toUpperCase()}</span>
            ) : (
              <a
                class="ctrl-btn"
                href={localePath(l, path)}
                hreflang={l}
                lang={l}
                data-lang-switch
                data-track="lang_switch"
                data-track-to={l}
                aria-label={`${l.toUpperCase()} — ${t(l).nav.readIn}`}
              >
                {l.toUpperCase()}
              </a>
            )
          )}
          <button
            type="button"
            class="ctrl-btn"
            id="btn-theme-toggle"
            data-action="toggleSiteTheme"
            data-label-system={d.nav.themeAuto}
            data-label-light={d.nav.themeLight}
            data-label-dark={d.nav.themeDark}
            data-track="theme_switch"
            title={d.nav.themeTitle}
          >
            {d.nav.themeAuto}
          </button>
          {cta && (
            <a
              href={calUrl('nav', lang)}
              data-track="cta_book"
              data-track-placement="nav"
              target="_blank"
              rel="noopener noreferrer"
              class="brutal-btn brutal-btn-lime brutal-btn-sm"
            >
              {d.nav.bookCall}
            </a>
          )}
        </div>
      </div>
    </header>

    <main id="top">
      <slot />

      {/* CONTACT & FOOTER */}
      <footer id="contact" class="section-block site-footer">
        <div class="container">
          <div class="contact-grid">
            <div>
              <span class="section-kicker">{d.footer.kicker}</span>
              <h2 class="section-title" style="margin-bottom: 12px;">{d.footer.title}</h2>
              <p class="footer-lead">{d.footer.lead}</p>
              <div class="hero-actions">
                {cta && (
                  <a href={calUrl('footer', lang)} target="_blank" rel="noopener noreferrer" class="brutal-btn brutal-btn-lime" data-track="cta_book" data-track-placement="footer">
                    {d.footer.bookCall}
                  </a>
                )}
                <button
                  type="button"
                  class="brutal-btn"
                  data-action="copy" data-copy={PROFILE.email}
                  data-track="email_copy"
                  data-track-placement="footer"
                >
                  {d.footer.copyEmail}
                </button>
              </div>
              <div class="footer-links">
                <a class="text-link" href={`mailto:${PROFILE.email}`} data-track="email_click" data-track-placement="footer">{PROFILE.email}</a>
                <a class="text-link" href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" data-track="linkedin_click" data-track-placement="footer">LinkedIn ↗</a>
                <a class="text-link" href={PROFILE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
                <a class="text-link" href="/gleb-rosev-cv.pdf" target="_blank" download="Gleb_Rosev_Founding_Engineer_CV.pdf" data-track="cv_download" data-track-placement="footer">
                  {d.footer.cv}
                </a>
                <a class="text-link" href={localePath(lang, '/hire/')} aria-current={path === '/hire/' ? 'page' : undefined}>
                  {d.footer.hire}
                </a>
                <a class="text-link" href={localePath(lang, '/how-its-built/')} aria-current={path === '/how-its-built/' ? 'page' : undefined}>
                  {d.footer.howBuilt}
                </a>
                <a class="text-link" href="/llms.txt" target="_blank" title="Plain-text Markdown context for AI Agents & LLMs">/llms.txt ↗</a>
              </div>
            </div>

            <div class="footer-facts">
              <dl>
              <div class="contact-row">
                <dt class="label">{d.footer.education}</dt>
                <dd>{d.footer.educationValue}</dd>
              </div>
              <div class="contact-row">
                <dt class="label">{d.footer.languages}</dt>
                <dd>{PROFILE.languages.map((l) => l[lang]).join(' · ')}</dd>
              </div>
              <div class="contact-row">
                <dt class="label">{d.footer.based}</dt>
                <dd>{PROFILE.location[lang]} · {d.footer.remote} · {PROFILE.timezone}</dd>
              </div>
              <div class="contact-row" data-now data-now-time={d.now.time} data-now-night={d.now.night} data-now-just-now={d.now.justNow}>
                <dt class="label">{d.now.label}</dt>
                <dd>
                  {d.now.commit.split('{ago}')[0]}<time datetime={commit.date}>{new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(commit.date))}</time>{d.now.commit.split('{ago}')[1]}
                  <a class="text-link" href={commitUrl(commit.sha)} target="_blank" rel="noopener noreferrer">{commit.subject}</a>
                </dd>
              </div>
              </dl>
              <p class="footer-fineprint">
                {d.footer.cvBuiltFrom}
                <code>profile.ts</code> (<code>canary #42</code>)
                · © {new Date().getFullYear()} {d.meta.name}
              </p>
              {/* How fast this page opened for this visitor, filled in by scripts/speed.ts; empty without JS. */}
              <p class="footer-fineprint" data-speed hidden {...Object.fromEntries(Object.entries(d.speed).map(([k, v]) => [`data-speed-${k}`, v]))}></p>
            </div>
          </div>
        </div>
      </footer>
    </main>

    {/* Toast Notification */}
    <div id="brutal-toast" class="toast-notification" role="status" aria-live="polite" data-copied={d.toast.copied}
      data-copy-failed={d.toast.copyFailed}
      data-offline={d.offline.toast}
      data-tab-wait={d.tab.wait}
      {...Object.fromEntries(Object.entries(d.keys).map(([k, v]) => [`data-keys-${k}`, v]))}
      data-arrival-case={d.arrival.case}
      data-arrival-linkedin={d.arrival.linkedin}
      data-arrival-linkedin-post={d.arrival.linkedinPost}
      data-arrival-hire={d.arrival.hire}
      data-changes-title={d.changes.title}
      data-changes-post-one={d.changes.postOne}
      data-changes-post-few={d.changes.postFew}
      data-changes-post-many={d.changes.postMany}
      data-changes-post-other={d.changes.postOther}
      data-changes-more={d.changes.more}
      data-changes-updated={d.changes.updated}
      data-changes-tag={d.changes.tag}
      data-changes-close={d.changes.close}
    >
      {d.toast.copiedDefault}
    </div>

    {/* Before page scripts: the data-action click handlers and the analytics toggle listener exist first. Global helpers (theme, language links, URL params, clipboard) and funnel analytics (Umami custom events) */}
    <script>
      import { initActions } from '../scripts/actions';
      import { initSite } from '../scripts/site';
      import { initAnalytics } from '../scripts/analytics';
      import { initVadLoader } from '../scripts/vad/loader';
      import { initShowMore } from '../scripts/show-more';
      initActions();
      initSite();
      initAnalytics();
      initVadLoader();
      // Paged lists (/writing/, /how-its-built/): one delegated click listener, idle where there is no [data-more].
      initShowMore();
    </script>
    <slot name="scripts" />

    {/* Vercel Web Analytics & Speed Insights: their plain script tags (same origin, served by Vercel);
         the Astro components would inline a loader the CSP has no hash for. */}
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline defer src="/_vercel/speed-insights/script.js"></script>
  </body>
</html>
