{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/partials/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/llm.txt",
      "destination": "/llms.txt",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "post",
          "value": "^post-1$"
        }
      ],
      "destination": "/writing/engineering-management-systems-thinking/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "post",
          "value": "^post-2$"
        }
      ],
      "destination": "/writing/every-engineering-estimate-is-two-things/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "post",
          "value": "^post-3$"
        }
      ],
      "destination": "/writing/the-new-ai-bottleneck/",
      "statusCode": 301
    },
    {
