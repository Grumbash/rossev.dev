        }
      ],
      "destination": "/writing/attackers-kept-attacking-opencode/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "post",
          "value": "^post-6$"
        }
      ],
      "destination": "/writing/technical-seniority-is-dead/",
